# ==========================================
# CONFIGURAÇÕES DO AMBIENTES HUB (EXEMPLO)
# Copie este arquivo para AmbientesHub/.env e ajuste com os seus dados reais.
# NUNCA versione o .env (permissões restritas: usuário atual + Administradores + SYSTEM).
# Chaves críticas vazias => funcionalidade correspondente fica DESABILITADA (fail-closed).
# ==========================================
APP_TERMINAL_FONT=Consolas
ADMIN_USER=seu_usuario_admin
ADMIN_AD_USER=seu_usuario_admin_ad
SCCM_SITE_SERVER=srv-sccm.dominio.local
SCCM_SITE_CODE=XXX
URL_OTRS=https://central.empresa.gov.br/
URL_CITSMART=https://suporte.empresa.gov.br/
URL_BANCADA_LOCAL=http://localhost:8501/
BANCADA_WINDOWS_DIR=\\wsl.localhost\SuaDistro\home\seu_usuario\projeto
BANCADA_WSL_DIR=/home/seu_usuario/projeto
BANCADA_WSL_DISTRO=SuaDistro
WHATSAPP_PWA_ARGS="-taskbar-tab" "uuid" "-new-window" "https://web.whatsapp.com/" "-profile" "C:\Users\usuario\AppData\Roaming\Mozilla\Firefox\Profiles\perfil" "-container" "0"
RSAT_MSU_NETWORK_PATH=
DEVICE_REPORTS_DIR=
CMRCVIEWER_PATH=
FIREFOX_PATH=
PROTECTED_PROFILES=Public, Default, Default User, All Users, Administrator, Administrador
PING_TIMEOUT_MS=2500
MINIMIZE_TO_TRAY=true
