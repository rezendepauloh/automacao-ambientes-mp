<ui:FluentWindow x:Class="AmbientesHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Ambientes Hub — Central de Produtividade &amp; Performance"
        Icon="Assets/app.ico"
        Height="820" Width="1160"
        MinHeight="680" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Customizada Fluent com Input de Pesquisa Centralizado Integrado no Header -->
        <ui:TitleBar Grid.Row="0" Title="Ambientes Hub">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/app.ico" Width="18" Height="18" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <ui:TextBox x:Name="TxtGlobalSearch" 
                            PlaceholderText="Pesquisar (máquinas, usuários, módulos)..." 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            Width="380" Height="32" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            KeyDown="TxtGlobalSearch_KeyDown"
                            ToolTip="Pesquisa global: digite máquina, usuário ou módulo e pressione Enter" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Layout com Menu Lateral Vertical Responsivo (Expandido / Recolhido com Splitter) -->
        <Grid Grid.Row="1" Margin="10,5,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColNavPane" Width="240" MinWidth="60" MaxWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Painel Lateral Esquerdo Estilo Task Manager & PowerToys -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho com Botão Hambúrguer e Título Opcional -->
                    <Grid Grid.Row="0" Margin="6,6,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:Button x:Name="BtnToggleNav" Grid.Column="0" Appearance="Transparent" Click="BtnToggleNav_Click" Width="38" Height="36" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Expandir/Recolher menu lateral">
                            <ui:SymbolIcon Symbol="Navigation24" FontSize="18" />
                        </ui:Button>

                        <TextBlock x:Name="TxtNavTitle" Grid.Column="1" Text="MÓDULOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <!-- Lista com Itens com Ícone e Texto (Sem Scroll Horizontal) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="NavListBox" SelectionChanged="NavListBox_SelectionChanged" SelectedIndex="0" Background="Transparent" BorderThickness="0" Margin="4,0,4,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" CornerRadius="6" Background="Transparent" Padding="8,8">
                                                    <Grid>
                                                        <!-- Indicador de Seleção Ativo (Pill Azul) -->
                                                        <Rectangle x:Name="ActivePill" Width="3.5" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" Margin="-4,0,0,0" />

                                                        <ContentPresenter />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                        <Setter TargetName="ActivePill" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True" />
                                                            <Condition Property="IsSelected" Value="False" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <!-- Item 0: Ambientes Virtuais -->
                            <ListBoxItem ToolTip="Ambientes Virtuais">
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🛠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLbl0" Grid.Column="1" Text="Ambientes Virtuais" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 1: Acesso Remoto -->
                            <ListBoxItem ToolTip="Acesso Remoto">
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🖥️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLbl1" Grid.Column="1" Text="Acesso Remoto" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 2: Limpeza AD & SCCM -->
                            <ListBoxItem ToolTip="Limpeza AD &amp; SCCM">
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🗑️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLbl2" Grid.Column="1" Text="Limpeza AD &amp; SCCM" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 3: Saneamento de Recursos -->
                            <ListBoxItem ToolTip="Saneamento de Recursos">
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🧹" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLbl3" Grid.Column="1" Text="Saneamento de Recursos" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 4: Performance & Auditoria -->
                            <ListBoxItem ToolTip="Performance &amp; Auditoria">
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLbl4" Grid.Column="1" Text="Performance &amp; Auditoria" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 5: Apps & Provisionamento -->
                            <ListBoxItem ToolTip="Apps &amp; Provisionamento">
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLbl5" Grid.Column="1" Text="Apps &amp; Provisionamento" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 6: Configurações & Credenciais -->
                            <ListBoxItem ToolTip="Configurações &amp; Credenciais">
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLbl6" Grid.Column="1" Text="Configurações &amp; Credenciais" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </ListBoxItem>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Divisor Arrastável (GridSplitter para redimensionar o menu à vontade) -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

            <!-- Área de Conteúdo Principal Alternável -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid Margin="20">
                    
                    <!-- PAINEL 0: AMBIENTES VIRTUAIS -->
                    <Grid x:Name="PanelAmbientes" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Selecione o Ambiente de Trabalho" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Fecha as tarefas anteriores e carrega o novo fluxo limpo no Firefox." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <WrapPanel Orientation="Horizontal" ItemWidth="280" ItemHeight="130">
                                <ui:CardAction Margin="8" Click="BtnModoChamados_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🛠️ Modo Chamados" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Fecha tudo e abre WhatsApp PWA, CitSmart e OTRS no Firefox." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </ui:CardAction>

                                <ui:CardAction Margin="8" Click="BtnModoContratos_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🛠️ Modo Contratos" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Gestão contratual, termos e pastas de documentação." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </ui:CardAction>

                                <ui:CardAction Margin="8" Click="BtnModoImpressoras_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🛠️ Modo Impressoras" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Servidores de impressão, filas e ferramentas de suporte." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </ui:CardAction>

                                <ui:CardAction Margin="8" Click="BtnModoPxe_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🛠️ Modo PXE" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Bancada de formatação, deploys de imagem e boot de rede." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </ui:CardAction>

                                <ui:CardAction Margin="8" Click="BtnModoEstudo_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🛠️ Modo Estudo" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Ambiente focado com ferramentas de leitura e documentação." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </ui:CardAction>
                            </WrapPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- PAINEL 1: ACESSO REMOTO -->
                    <Grid x:Name="PanelRemoto" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Central de Acesso Remoto &amp; Diagnóstico" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Pesquise por nome da máquina (ex: 80600) ou usuário logado (ex: usuario.sobrenome) com correspondência ampla." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Barra de Consulta Ampla -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox x:Name="TxtComputerName" Grid.Column="0" PlaceholderText="Pesquise por máquina (ex: 80600 ou MPE-80600) ou usuário conectado (ex: usuario.sobrenome)..." Margin="0,0,10,0" KeyDown="TxtComputerName_KeyDown" Height="38" />
                                <ui:Button x:Name="BtnConsultarRemoto" Grid.Column="1" Appearance="Primary" Content="Pesquisar" Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnConsultarRemoto_Click" Padding="18,9" />
                            </Grid>
                        </Border>

                        <!-- Conteúdo Scrollável: Lista de Resultados + Console de Diagnóstico -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                            <StackPanel>

                                <!-- Card de Placeholder (Antes da consulta) -->
                                <Border x:Name="PlaceholderRemoteCard" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="30" Margin="0,0,0,12" Visibility="Visible">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                        <TextBlock Text="Pesquisa Ampla de Máquinas &amp; Usuários" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Digite parte do nome da máquina (ex: 80600), o nome completo (MPE-80600) ou o usuário conectado (ex: usuario.sobrenome) para localizar dispositivos, status de rede e registros do AD &amp; SCCM." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="620" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Card de Carregamento (Durante a consulta) -->
                                <Border x:Name="LoadingRemoteCard" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="25" Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⏳" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="Pesquisando no Active Directory, Configuration Manager e diagnosticando rede..." FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Aguarde enquanto verificamos os dispositivos correspondentes e seus usuários." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Lista de Resultados Dinâmicos (ItemsControl) -->
                                <ItemsControl x:Name="ItemsMachineResults">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Cabeçalho do Card: Badge, Nome, Ações Rápidas -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <Border CornerRadius="4" Padding="8,3" Margin="0,0,10,0" Background="#064e3b">
                                                                    <TextBlock Text="{Binding OnlineBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#34d399" />
                                                                </Border>
                                                                <TextBlock Text="{Binding ComputerName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                                <ui:Button Appearance="Transparent" ToolTip="Copiar Nome da Máquina" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnCardCopyMachine_Click" Width="30" Height="30" Padding="0" Margin="6,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DnsHostName}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Appearance="Primary" Content="Acessar CmRcViewer" Icon="{ui:SymbolIcon Symbol=Headset24}" Click="BtnCardConnectSccm_Click" Margin="0,0,8,0" Padding="14,8" />
                                                            <ui:Button Appearance="Secondary" Content="Acessar RDP" Icon="{ui:SymbolIcon Symbol=Window24}" Click="BtnCardConnectRdp_Click" Padding="14,8" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Separator Grid.Row="1" Margin="0,0,0,14" />

                                                    <!-- Corpo: 3 Colunas de Dados -->
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Bloco 1: Sessão & Usuários -->
                                                        <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                                            <StackPanel>
                                                                <TextBlock Text="👤 SESSÃO &amp; USUÁRIO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                                                <TextBlock Text="Usuário Conectado Atualmente:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Grid Margin="0,2,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding CurrentLogonUserDisplay}" FontSize="14" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <ui:Button Grid.Column="1" Appearance="Transparent" ToolTip="Copiar Usuário Conectado" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnCardCopyUser_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                </Grid>

                                                                <TextBlock Text="Usuário Primário (Dono):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding PrimaryUserDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />

                                                                <TextBlock Text="Endereço IP &amp; Latência:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Grid Margin="0,2,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding IpWithLatency}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                                    <ui:Button Grid.Column="1" Appearance="Transparent" ToolTip="Copiar Endereço IP" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnCardCopyIp_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Bloco 2: Active Directory -->
                                                        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                                            <StackPanel>
                                                                <TextBlock Text="🏛️ ACTIVE DIRECTORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                                                <TextBlock Text="Sistema Operacional:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding OperatingSystem}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />

                                                                <TextBlock Text="Criado em:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding WhenCreated}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10" />

                                                                <TextBlock Text="Unidade Organizacional (OU):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding DistinguishedName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DistinguishedName}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Bloco 3: Configuration Manager (SCCM) -->
                                                        <Border Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14">
                                                            <StackPanel>
                                                                <TextBlock Text="📡 CONFIGURATION MANAGER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                                                <TextBlock Text="Atividade do Agente SCCM:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ClientStatus}" FontSize="13" FontWeight="SemiBold" Foreground="#34d399" Margin="0,2,0,10" />

                                                                <TextBlock Text="MAC Address:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Grid Margin="0,2,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding MacAddressDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#f59e0b" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <ui:Button Grid.Column="1" Appearance="Transparent" ToolTip="Copiar MAC Address" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnCardCopyMac_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                </Grid>

                                                                <TextBlock Text="ResourceID:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ResourceId}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,10" />

                                                                <TextBlock Text="SMSID (GUID):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding SmsId}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SmsId}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Console de Log para Diagnóstico de Conexão -->
                                <Border Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="80" MaxHeight="130">
                                    <RichTextBox x:Name="RichRemoteLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" VerticalScrollBarVisibility="Auto">
                                        <FlowDocument />
                                    </RichTextBox>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- PAINEL 2: LIMPEZA AD & SCCM -->
                    <Grid x:Name="PanelAdSccm" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Consulta &amp; Desprovisionamento (AD &amp; SCCM)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Consulte se a máquina está cadastrada nas bases (busca por nome ou parte, ex: 80600) ou efetue a exclusão direta para permitir reformatação via PXE." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Máquina Alvo:" FontWeight="Medium" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox x:Name="TxtAdTargetComputer" Grid.Column="0" PlaceholderText="Ex: 80600 ou MPE-80600" Margin="0,0,10,0" KeyDown="TxtAdTargetComputer_KeyDown" />
                                    <ui:Button x:Name="BtnAdQuery" Grid.Column="1" Appearance="Secondary" Content="Consultar Máquina" Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnAdQuery_Click" Margin="0,0,10,0" />
                                    <ui:Button x:Name="BtnAdClean" Grid.Column="2" Appearance="Danger" Content="Excluir do AD &amp; SCCM" Icon="{ui:SymbolIcon Symbol=Delete24}" Click="BtnAdClean_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Margin="0,20,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichAdLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="13" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 3: SANEAMENTO -->
                    <Grid x:Name="PanelSaneamento" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Selecione o que Fechar e Otimizar" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Defina exatamente o que deve ser encerrado ou mantido durante o saneamento." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                    <CheckBox x:Name="ChkOffice" Content="Salvar e Fechar Office (Word/Excel)" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkBrowsers" Content="Fechar Chrome &amp; Edge" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkFirefox" Content="Fechar Firefox Atual" IsChecked="False" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkTeams" Content="Fechar Microsoft Teams" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkAdminTools" Content="Fechar Consoles AD, SCCM e SAJMP" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkUtilities" Content="Fechar FoxitPDF, Bloco de Notas e Relógio" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkTelemetry" Content="Parar Telemetria (CompatTelRunner)" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkRestartExplorer" Content="Reiniciar Explorador de Arquivos (Modo Nuclear)" IsChecked="False" Margin="0,0,24,12" />
                                </WrapPanel>

                                <Separator Grid.Row="1" Margin="0,5,0,15" />

                                <ui:Button x:Name="BtnLimparAmbiente" Grid.Row="2" Appearance="Primary" Content="Executar Limpeza com Itens Selecionados" Icon="{ui:SymbolIcon Symbol=Broom24}" Click="BtnLimparAmbiente_Click" Padding="18,10" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Margin="0,15,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichCleanLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="13" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 4: PERFORMANCE & AUDITORIA -->
                    <Grid x:Name="PanelPerformance" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho + Aviso Admin -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Auditoria de Lentidão &amp; Otimização (Debloat)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Diagnóstico nativo de RAM, bloatwares, TRIM, hibernação e WSL/Docker com aplicação direta em C#." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BadgeAdminStatus" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" Background="#33f59e0b" BorderBrush="#66f59e0b" BorderThickness="1">
                                    <TextBlock x:Name="TxtPerfAdminStatus" Text="Modo Usuário" FontSize="12" FontWeight="SemiBold" Foreground="#fbbf24" />
                                </Border>
                                <ui:Button x:Name="BtnReiniciarComoAdmin" Content="Reiniciar como Admin" Icon="{ui:SymbolIcon Symbol=ShieldKeyhole24}" Appearance="Secondary" Click="BtnReiniciarComoAdmin_Click" Padding="12,6" />
                            </StackPanel>
                        </Grid>

                        <!-- Cartões de Resumo Rápido (KPIs da Auditoria) -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Memória RAM Livre" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPerfRamKpi" Text="Aguardando auditoria" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Disco C: &amp; Hibernação" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPerfDiskKpi" Text="Aguardando auditoria" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Status SSD TRIM" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPerfTrimKpi" Text="Aguardando auditoria" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Bloatwares UWP" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPerfBloatKpi" Text="Aguardando auditoria" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Opções de Otimização & Ações -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                    <CheckBox x:Name="ChkOptTelemetryServices" Content="Desativar Serviços Telemetria (DiagTrack/SysMain/WerSvc)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptTelemetryReg" Content="Desativar Telemetria &amp; Anúncios no Registro" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptBloatApps" Content="Remover Bloatware Apps (UWP + DISM)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptHibernation" Content="Desativar Hibernação (remover C:\hiberfil.sys)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptTrim" Content="Ativar TRIM em SSDs (fsutil)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptBingSearch" Content="Desativar Busca Web (Bing) no Menu Iniciar" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptUiSpeed" Content="Acelerar Menus da Interface (MenuShowDelay 50ms)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptDockerCache" Content="Limpar Cache do Docker (Builder &amp; Órfãos)" IsChecked="True" Margin="0,0,20,10" ToolTip="Executa 'docker builder prune' e 'system prune' liberando cache sem apagar suas imagens ativas ou volumes." />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,10">
                                        <CheckBox x:Name="ChkOptWslConfig" Content="Limitar RAM do WSL 2 (.wslconfig):" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="CmbWslMemory" SelectedIndex="2" Width="90" Height="32">
                                            <ComboBoxItem Content="2GB" />
                                            <ComboBoxItem Content="3GB" />
                                            <ComboBoxItem Content="4GB" />
                                            <ComboBoxItem Content="6GB" />
                                            <ComboBoxItem Content="8GB" />
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>

                                <Separator Grid.Row="1" Margin="0,4,0,12" />

                                <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                    <ui:Button x:Name="BtnExecutarAuditoria" Appearance="Primary" Content="Executar Auditoria Completa" Icon="{ui:SymbolIcon Symbol=Pulse24}" Click="BtnExecutarAuditoria_Click" Margin="0,0,10,0" Padding="16,9" />
                                    <ui:Button x:Name="BtnAplicarOtimizacao" Appearance="Success" Content="Aplicar Otimizações Selecionadas" Icon="{ui:SymbolIcon Symbol=Flash24}" Click="BtnAplicarOtimizacao_Click" Margin="0,0,10,0" Padding="16,9" />
                                    <ui:Button x:Name="BtnReverterServicos" Appearance="Secondary" Content="Reverter Serviços (Rollback)" Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" Click="BtnReverterServicos_Click" Padding="14,9" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Terminal de Diagnóstico e Aplicação -->
                        <Border Grid.Row="3" Margin="0,12,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichPerformanceLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="13" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 5: APPS INSTALADOS & PROVISIONAMENTO -->
                    <Grid x:Name="PanelApps" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="170" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho + Admin + Atualizar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Apps Instalados &amp; Provisionamento Pós-Formatação" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Detecta consoles administrativos corporativos (AD MMC / SCCM) e prepara futuros pacotes via winget (source winget)." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BadgeAppsAdminStatus" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" Background="#33f59e0b" BorderBrush="#66f59e0b" BorderThickness="1">
                                    <TextBlock x:Name="TxtAppsAdminStatus" Text="Modo Usuário" FontSize="12" FontWeight="SemiBold" Foreground="#fbbf24" />
                                </Border>
                                <ui:Button x:Name="BtnAppsReiniciarAdmin" Content="Reiniciar como Admin" Icon="{ui:SymbolIcon Symbol=ShieldKeyhole24}" Appearance="Secondary" Click="BtnReiniciarComoAdmin_Click" Padding="12,6" />
                            </StackPanel>
                        </Grid>

                        <!-- Barra de Opções -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkInstallSilent" Grid.Column="0" Content="Instalação Silenciosa automática (/q /quiet --silent)" IsChecked="True" VerticalAlignment="Center" />
                                <ui:Button x:Name="BtnVerificarApps" Grid.Column="1" Appearance="Primary" Content="Atualizar Status dos Apps" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Click="BtnVerificarApps_Click" Padding="14,8" />
                            </Grid>
                        </Border>

                        <!-- Listagem de Softwares -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LstSoftwareCatalog">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Ícone Emoji do App no canto esquerdo -->
                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding IconEmoji}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Detalhes do Software -->
                                                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Border Background="#1e293b" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#94a3b8" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="#94a3b8" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Ações no canto direito -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <!-- Badge Instalado (Versão Atual) -->
                                                    <Border Visibility="{Binding InstalledBadgeVisibility}" Background="#1a34d399" BorderBrush="#4d34d399" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#34d399" FontSize="16" Margin="0,0,6,0" />
                                                            <TextBlock Text="Instalado" FontSize="12" FontWeight="SemiBold" Foreground="#34d399" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Botão Atualizar (Quando há nova versão detectada) -->
                                                    <ui:Button Visibility="{Binding UpdateButtonVisibility}" IsEnabled="{Binding CanClickInstall}" Content="Atualizar" Appearance="Success" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Tag="{Binding}" Click="BtnInstallSoftware_Click" Margin="0,0,8,0" Padding="14,7" ToolTip="Atualizar para a versão mais recente via winget" />

                                                    <!-- Botão Instalar (Quando não instalado) -->
                                                    <ui:Button Visibility="{Binding InstallButtonVisibility}" IsEnabled="{Binding CanClickInstall}" Content="{Binding InstallButtonText}" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Tag="{Binding}" Click="BtnInstallSoftware_Click" Margin="0,0,8,0" Padding="14,7" />

                                                    <!-- Botão Desinstalar (Casos extremos) -->
                                                    <ui:Button Visibility="{Binding UninstallButtonVisibility}" IsEnabled="{Binding CanClickInstall}" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Delete24}" Tag="{Binding}" Click="BtnUninstallSoftware_Click" Padding="10,7" ToolTip="Desinstalar este software da máquina" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Terminal de Instalação -->
                        <Border Grid.Row="3" Margin="0,12,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichAppsLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="13" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 6: CONFIGURAÇÕES & COFRE -->
                    <Grid x:Name="PanelConfig" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Parâmetros do Sistema &amp; Credenciais" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Gerencie cofres DPAPI seguros, URLs corporativas, servidores do SCCM e tipografia." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <!-- Seção de Cofres e Credenciais XML -->
                                    <TextBlock Text="Cofre de Credenciais (DPAPI .xml)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="Geração e teste das credenciais seguras usadas nos scripts e rotinas administrativas." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />

                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <ui:Button x:Name="BtnCheckAdminXml" Appearance="Secondary" Content="Verificar Credencial Local (XML)" Icon="{ui:SymbolIcon Symbol=ShieldKeyhole24}" Click="BtnCheckAdminXml_Click" Margin="0,0,12,0" Padding="14,10" />
                                        <ui:Button x:Name="BtnCheckAdminAdXml" Appearance="Secondary" Content="Verificar Credencial AD (XML)" Icon="{ui:SymbolIcon Symbol=ShieldKeyhole24}" Click="BtnCheckAdminAdXml_Click" Margin="0,0,12,0" Padding="14,10" />
                                        <ui:Button x:Name="BtnCriarAdminAdXml" Appearance="Primary" Content="Criar/Atualizar Cofre AD (XML)" Icon="{ui:SymbolIcon Symbol=Key24}" Click="BtnCriarAdminAdXml_Click" Padding="14,10" />
                                    </WrapPanel>

                                    <!-- Console de Log para operações com o cofre -->
                                    <Border Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15" MinHeight="90" MaxHeight="130">
                                        <RichTextBox x:Name="RichScriptsLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" VerticalScrollBarVisibility="Auto">
                                            <FlowDocument />
                                        </RichTextBox>
                                    </Border>

                                    <Separator Margin="0,5,0,15" />

                                    <!-- Seção de Tipografia -->
                                    <TextBlock Text="Aparência do Terminal" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                                    
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Selecione a Fonte do Console/Terminal:" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ComboBox x:Name="CmbFonts" SelectionChanged="CmbFonts_SelectionChanged" Height="38" />
                                        </StackPanel>
                                        <ui:Button x:Name="BtnSalvarFonte" Grid.Column="1" VerticalAlignment="Bottom" Content="Salvar como Padrão" Icon="{ui:SymbolIcon Symbol=Save24}" Click="BtnSalvarFonte_Click" />
                                    </Grid>

                                    <Separator Margin="0,5,0,15" />

                                    <TextBlock Text="Contas Administrativas" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Usuário Admin Local:" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ui:TextBox x:Name="TxtCfgAdminUser" PlaceholderText="admin" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Usuário Admin AD (Domínio):" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ui:TextBox x:Name="TxtCfgAdminAdUser" PlaceholderText="admin_ad" />
                                        </StackPanel>
                                    </Grid>

                                    <Separator Margin="0,5,0,15" />

                                    <TextBlock Text="SCCM / MECM" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Servidor SCCM (Site Server):" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ui:TextBox x:Name="TxtCfgSccmServer" PlaceholderText="srv-1046.in.mpe.ms.gov.br" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Site Code:" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ui:TextBox x:Name="TxtCfgSccmCode" PlaceholderText="PGJ" />
                                        </StackPanel>
                                    </Grid>

                                    <Separator Margin="0,10,0,15" />

                                    <TextBlock Text="Portais &amp; Navegação" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                    <TextBlock Text="URL do OTRS (Central):" FontWeight="Medium" Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtCfgOtrs" PlaceholderText="https://central.mpms.mp.br/" Margin="0,0,0,12" />

                                    <TextBlock Text="URL do CitSmart (Suporte):" FontWeight="Medium" Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtCfgCitsmart" PlaceholderText="https://suporte.mpms.mp.br/inbox/..." Margin="0,0,0,12" />

                                    <TextBlock Text="URL Bancada Local (WSL / Docker):" FontWeight="Medium" Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtCfgBancada" PlaceholderText="http://localhost:8501/" Margin="0,0,0,12" />

                                    <TextBlock Text="Argumentos PWA do WhatsApp Firefox:" FontWeight="Medium" Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtCfgWhatsapp" PlaceholderText="-taskbar-tab ... -profile ..." Margin="0,0,0,20" />

                                    <ui:Button x:Name="BtnSalvarConfiguracoes" Appearance="Primary" Content="Salvar Configurações no .env" Icon="{ui:SymbolIcon Symbol=Save24}" Click="BtnSalvarConfiguracoes_Click" Padding="18,10" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- Barra de Status Rodapé -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="15,6">
            <TextBlock x:Name="TxtFooterStatus" Text="Ambientes Hub ativo e pronto." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</ui:FluentWindow>
