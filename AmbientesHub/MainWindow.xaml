                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox x:Name="TxtCfgDbPort" Grid.Column="0" PlaceholderText="5432" />
                                                <ui:Button Grid.Column="1" Margin="6,0,0,0" Padding="8,6" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowReset24}" ToolTip="Preencher valor padrão" Click="BtnResetConfigField_Click" Tag="BANCADA_DB_PORT" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Nome do Banco (POSTGRES_DB):" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ui:TextBox x:Name="TxtCfgDbName" PlaceholderText="bancada_db" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Usuário (POSTGRES_USER):" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ui:TextBox x:Name="TxtCfgDbUser" PlaceholderText="usuario_banco" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Senha (POSTGRES_PASSWORD):" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ui:PasswordBox x:Name="TxtCfgDbPassword" PlaceholderText="Senha do PostgreSQL local" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Documentação / SharePoint FAQs -->
                                    <TextBlock Text="📚 Documentação &amp; Tutoriais SharePoint (OneDrive)" FontSize="14" FontWeight="SemiBold" Foreground="#38bdf8" Margin="0,4,0,8" />
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Pasta Sincronizada de Tutoriais &amp; FAQs (SHAREPOINT_FAQS_DIR):" FontWeight="Medium" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtCfgSharePointFaqsDir" Grid.Column="0" PlaceholderText="C:\Users\usuario.teste\OneDrive - Organizacao\Tutoriais-FAQs" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Padding="8,6" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowReset24}" ToolTip="Preencher valor padrão" Click="BtnResetConfigField_Click" Tag="SHAREPOINT_FAQS_DIR" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,18">
                                        <TextBlock Text="URL Web do SharePoint para Vídeos no HTML Offline (SHAREPOINT_FAQS_WEB_URL):" FontWeight="Medium" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtCfgSharePointFaqsWebUrl" Grid.Column="0" PlaceholderText="https://empresa.sharepoint.com/sites/equipe/Shared%20Documents/Tutoriais-FAQs" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Padding="8,6" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowReset24}" ToolTip="Preencher valor padrão" Click="BtnResetConfigField_Click" Tag="SHAREPOINT_FAQS_WEB_URL" />
                                        </Grid>
                                    </StackPanel>

                                    <ui:Button x:Name="BtnSalvarConfiguracoes" Appearance="Primary" Content="Salvar Configurações no .env" Icon="{ui:SymbolIcon Symbol=Save24}" Click="BtnSalvarConfiguracoes_Click" Padding="18,10" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- PAINEL 10: BACKUP & RESTORE DE USUÁRIOS (USMT) -->
                    <Grid x:Name="PanelUsmtBackup" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="175" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho + Status do USMT -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Backup &amp; Restore de Perfis de Usuários (Windows USMT)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Migração segura de dados de usuários via ScanState / LoadState em máquinas locais (.) ou remotas, com seleção individual e zero exclusão de perfis." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="BadgeUsmtBinStatus" Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="10,5" Background="#1e293b" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtUsmtBinStatus" Text="⚪ Verificando USMT..." FontSize="12" FontWeight="Bold" Foreground="#94a3b8" />
                            </Border>
                            <ui:Button x:Name="BtnUsmtDownloadBin" Grid.Column="2" Appearance="Secondary" Content="Baixar / Detectar USMT" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Click="BtnUsmtDownloadBin_Click" VerticalAlignment="Center" Padding="12,6" ToolTip="Localiza o USMT instalado ou baixa/instala o Windows ADK USMT salvando em Configurações" />
                        </Grid>

                        <!-- Configuração de Máquina Alvo, Destino/Origem e Opções USMT -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Computador Alvo (. = Local ou Hostname/IP):" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtUsmtTargetComputer" Grid.Column="0" Text="." PlaceholderText=". ou DOMINIO-PC01" KeyDown="TxtUsmtTargetComputer_KeyDown" Height="34" />
                                            <ui:Button x:Name="BtnUsmtQueryUsers" Grid.Column="1" Appearance="Primary" Content="Listar Perfis" Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnUsmtQueryUsers_Click" Margin="6,0,0,0" Padding="12,7" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Chave / Senha de Criptografia (Opcional):" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                        <ui:TextBox x:Name="TxtUsmtEncryptKey" PlaceholderText="Deixe vazio para pacote sem senha" Height="34" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Pasta do Pacote USMT (Destino do Backup / Origem do Restore):" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="TxtUsmtStorePath" Grid.Column="0" PlaceholderText="C:\Backups\USMT_Estacao ou \\servidor\backups\USMT_Estacao" Height="34" />
                                        <ui:Button x:Name="BtnUsmtBrowseStore" Grid.Column="1" Appearance="Secondary" Content="Procurar..." Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Click="BtnUsmtBrowseStore_Click" Margin="6,0,0,0" Padding="10,7" />
                                    </Grid>
                                </StackPanel>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox x:Name="ChkUsmtMigApp" Content="MigApp.xml (Apps)" IsChecked="True" Margin="0,0,14,4" />
                                    <CheckBox x:Name="ChkUsmtMigDocs" Content="MigDocs.xml (Documentos)" IsChecked="True" Margin="0,0,14,4" />
                                    <CheckBox x:Name="ChkUsmtMigUser" Content="MigUser.xml (Perfil Clássico)" IsChecked="False" Margin="0,0,14,4" />
                                    <CheckBox x:Name="ChkUsmtCompress" Content="Compactar Pacote" IsChecked="True" Margin="0,0,14,4" />
                                    <CheckBox x:Name="ChkUsmtCreateLocalAccounts" Content="Criar Contas Locais no Restore (/lac /lae)" IsChecked="False" Margin="0,0,0,4" />
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnUsmtRunBackup" Appearance="Primary" Content="Iniciar Backup (ScanState)" Icon="{ui:SymbolIcon Symbol=Save24}" Click="BtnUsmtRunBackup_Click" Margin="0,0,8,4" Padding="14,8" />
                                    <ui:Button x:Name="BtnUsmtRunRestore" Appearance="Secondary" Content="Restaurar Backup (LoadState)" Icon="{ui:SymbolIcon Symbol=ArrowUpload24}" Click="BtnUsmtRunRestore_Click" Margin="0,0,8,4" Padding="14,8" />
                                    <ui:Button x:Name="BtnUsmtOpenStore" Appearance="Transparent" Content="Abrir Pasta" Icon="{ui:SymbolIcon Symbol=Folder24}" Click="BtnUsmtOpenStore_Click" Margin="0,0,0,4" Padding="10,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Lista Selecionável de Usuários para Backup / Restore -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtUsmtUsersHeader" Grid.Column="0" Text="Clique em 'Listar Perfis' para escolher os usuários do backup (nenhum usuário será excluído):" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button x:Name="BtnUsmtSelectAllUsers" Appearance="Secondary" Content="Marcar Todos" Click="BtnUsmtSelectAllUsers_Click" Padding="10,5" Margin="0,0,6,0" />
                                        <ui:Button x:Name="BtnUsmtClearUsers" Appearance="Transparent" Content="Desmarcar" Click="BtnUsmtClearUsers_Click" Padding="10,5" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ItemsUsmtUsers">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.5*" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="75" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Usuario}" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock Text="{Binding CaminhoPerfil}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                            <TextBlock Text="{Binding Nome}" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Sid}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                            <TextBlock Text="Último Uso:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{Binding UltimoUso}" FontSize="11" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="4" Text="{Binding EspacoDiscoTexto}" FontWeight="Bold" FontSize="13" Foreground="#38bdf8" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <Border Visibility="{Binding ActiveBadgeVisibility}" Background="#1410b981" BorderBrush="#10b981" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                                <TextBlock Text="🟢 Logado Agora" FontSize="11" Foreground="#10b981" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Visibility="{Binding RemovableBadgeVisibility}" Background="#1438bdf8" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                                <TextBlock Text="Perfil Offline" FontSize="11" Foreground="#38bdf8" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Terminal de Execução USMT -->
                        <Border Grid.Row="3" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Console de Execução USMT (ScanState / LoadState — Sem Exclusão de Perfis)" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8" Margin="0,0,0,4" />
                                <RichTextBox x:Name="RichUsmtLogs" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" VerticalScrollBarVisibility="Auto">
                                    <FlowDocument />
                                </RichTextBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PAINEL 11: BANCADA STREAMLIT (DOCKER WSL) -->
                    <Grid x:Name="PanelBancada" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Sistema Bancada STI (Streamlit Docker / WSL)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Gerenciamento de containers Docker, inicialização do Streamlit (localhost:8501) e monitoramento de logs em tempo real." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="BadgeBancadaStatus" Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="10,5" Background="#1e293b">
                                <TextBlock x:Name="TxtBancadaStatus" Text="⚪ Verificando..." FontSize="12" FontWeight="Bold" Foreground="#94a3b8" />
                            </Border>
                        </Grid>

                        <!-- Barra de Ações Rápidas -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                    <ui:Button x:Name="BtnStartBancada" Appearance="Primary" Content="Iniciar Docker Bancada" Icon="{ui:SymbolIcon Symbol=Play24}" Click="BtnStartBancada_Click" Margin="0,0,10,8" Padding="16,9" />
                                    <ui:Button x:Name="BtnStopBancada" Appearance="Danger" Content="Parar Docker (Down)" Icon="{ui:SymbolIcon Symbol=Stop24}" Click="BtnStopBancada_Click" Margin="0,0,10,8" Padding="16,9" />
                                    <ui:Button x:Name="BtnRestartBancada" Appearance="Secondary" Content="Reiniciar Bancada" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Click="BtnRestartBancada_Click" Margin="0,0,10,8" Padding="16,9" />
                                    <ui:Button x:Name="BtnRebuildBancada" Appearance="Secondary" Content="Reconstruir Docker (Build)" Icon="{ui:SymbolIcon Symbol=Wrench24}" Click="BtnRebuildBancada_Click" Margin="0,0,10,8" Padding="16,9" ToolTip="Executa docker compose build --no-cache e recria os containers" />
                                    <ui:Button x:Name="BtnOpenBancadaBrowser" Appearance="Secondary" Content="Abrir no Firefox / Navegador" Icon="{ui:SymbolIcon Symbol=Open24}" Click="BtnOpenBancadaBrowser_Click" Margin="0,0,10,8" Padding="16,9" />
                                    <ui:Button x:Name="BtnAttachBancadaLogs" Appearance="Secondary" Content="Conectar Logs" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Click="BtnAttachBancadaLogs_Click" Margin="0,0,10,8" Padding="14,9" ToolTip="Reconecta o terminal aos logs em tempo real do docker compose" />
                                    <ui:Button x:Name="BtnCheckBancadaHealth" Appearance="Transparent" Content="Checar Status" Icon="{ui:SymbolIcon Symbol=HeartPulse24}" Click="BtnCheckBancadaHealth_Click" Margin="0,0,10,8" Padding="14,9" />
                                    <ui:Button x:Name="BtnClearBancadaLogs" Appearance="Transparent" Content="Limpar Console" Icon="{ui:SymbolIcon Symbol=Broom24}" Click="BtnClearBancadaLogs_Click" Margin="0,0,0,8" Padding="14,9" />
                                </WrapPanel>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtBancadaDetails" Grid.Column="0" Text="URL: http://localhost:8501/ | WSL: Ubuntu-26.04" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ui:Button x:Name="BtnOpenBancadaFolder" Grid.Column="1" Appearance="Transparent" Content="Abrir Pasta no Windows" Icon="{ui:SymbolIcon Symbol=Folder24}" Click="BtnOpenBancadaFolder_Click" Padding="10,4" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Console / Terminal de Logs do Docker -->
                        <Border Grid.Row="2" Margin="0,15,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Terminal / Logs do Docker Compose (Web &amp; PostgreSQL)" FontSize="12" FontWeight="SemiBold" Foreground="#38bdf8" />
                                    <TextBlock Text="Logs em tempo real" HorizontalAlignment="Right" FontSize="11" Foreground="#64748b" />
                                </Grid>
                                <RichTextBox x:Name="RichBancadaLogs" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" FontFamily="Consolas, Cascadia Code, Courier New" VerticalScrollBarVisibility="Auto">
                                    <FlowDocument />
                                </RichTextBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PAINEL 12: CHAMADOS (OTRS & CITSMART - POSTGRESQL) -->
                    <Grid x:Name="PanelChamados" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Chamados Centralizados (OTRS &amp; CitSmart)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Consulta direta ao PostgreSQL da Bancada (somente leitura) com acesso rápido às páginas de cada chamado e sistema." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary" Content="Exportar / Imprimir" Icon="{ui:SymbolIcon Symbol=Print24}" Click="BtnExportChamados_Click" Margin="0,0,8,4" Padding="12,7" />
                                <ui:Button Appearance="Secondary" Content="Pasta Relatórios" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Click="BtnOpenChamadosReportsFolder_Click" Margin="0,0,8,4" Padding="12,7" />
                                <ui:Button Appearance="Secondary" Content="Abrir OTRS" Icon="{ui:SymbolIcon Symbol=Open24}" Click="BtnChamadosOpenOtrs_Click" Margin="0,0,8,4" Padding="12,7" />
                                <ui:Button Appearance="Secondary" Content="Abrir CitSmart" Icon="{ui:SymbolIcon Symbol=Open24}" Click="BtnChamadosOpenCitSmart_Click" Margin="0,0,0,4" Padding="12,7" />
                            </WrapPanel>
                        </Grid>

                        <!-- KPIs -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Total no Banco" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtChamadosKpiTotal" Text="-" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="Abertos" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtChamadosKpiAbertos" Text="-" FontSize="16" FontWeight="Bold" Foreground="#34d399" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="Base OTRS" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtChamadosKpiOtrs" Text="-" FontSize="16" FontWeight="Bold" Foreground="#93c5fd" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Base CitSmart" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtChamadosKpiCitSmart" Text="-" FontSize="16" FontWeight="Bold" Foreground="#5eead4" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Barra de Filtros -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <WrapPanel Orientation="Horizontal">
                                <ui:TextBox x:Name="TxtChamadosSearch" PlaceholderText="Buscar por ID, título, usuário, unidade, tag ou hostname..." MinWidth="260" MaxWidth="380" Height="34" Margin="0,0,10,4" KeyDown="TxtChamadosSearch_KeyDown" />
                                <ComboBox x:Name="CmbChamadosBase" Width="150" Height="34" Margin="0,0,10,4" SelectionChanged="CmbChamadosFilter_SelectionChanged">
