<ui:FluentWindow x:Class="AmbientesHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:AmbientesHub.Views"
        Title="Ambientes Hub — Central de Produtividade &amp; Performance"
        Icon="Assets/app.ico"
        Height="820" Width="1160"
        MinHeight="680" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Customizada Fluent com Input de Pesquisa Centralizado Integrado no Header -->
        <Grid Grid.Row="0">
            <ui:TitleBar x:Name="AppTitleBar" Title="Ambientes Hub">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="Assets/app.ico" Width="18" Height="18" />
                </ui:TitleBar.Icon>
                <ui:TitleBar.Header>
                    <ui:TextBox x:Name="TxtGlobalSearch" 
                                PlaceholderText="Pesquisar (máquinas, usuários, módulos)..." 
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                MinWidth="200" MaxWidth="380" Height="32" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                KeyDown="TxtGlobalSearch_KeyDown"
                                ToolTip="Pesquisa global: digite máquina, usuário ou módulo e pressione Enter" />
                </ui:TitleBar.Header>
                <ui:TitleBar.TrailingContent>
                    <!-- Badge Indicadora de Privilégio (Admin vs Usuário Padrão) alinhada à direita, antes dos botões de controle -->
                    <Border x:Name="TitleBarAdminBadge"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            CornerRadius="12"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonDown="TitleBarAdminBadge_MouseDown"
                            ToolTip="Clique para alternar o modo de execução (Admin / Padrão)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="IconTitleBarAdmin" Symbol="Shield20" FontSize="13" Margin="0,0,5,0" />
                            <TextBlock x:Name="TxtTitleBarAdmin" Text="Usuário" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Grid>

        <!-- Layout com Menu Lateral Vertical Responsivo (Expandido / Recolhido com Splitter) -->
        <Grid Grid.Row="1" Margin="10,5,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColNavPane" Width="240" MinWidth="60" MaxWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Painel Lateral Esquerdo Estilo Task Manager & PowerToys -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho com Botão Hambúrguer e Título Opcional -->
                    <Grid Grid.Row="0" Margin="6,6,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:Button x:Name="BtnToggleNav" Grid.Column="0" Appearance="Transparent" Click="BtnToggleNav_Click" Width="38" Height="36" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Expandir/Recolher menu lateral">
                            <ui:SymbolIcon Symbol="Navigation24" FontSize="18" />
                        </ui:Button>

                        <TextBlock x:Name="TxtNavTitle" Grid.Column="1" Text="MÓDULOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <!-- NavListBox oculto mantido para compatibilidade de SelectedIndex -->
                    <ListBox x:Name="NavListBox" Visibility="Collapsed" SelectionChanged="NavListBox_SelectionChanged" SelectedIndex="0">
                        <ListBoxItem Content="0" /><ListBoxItem Content="1" /><ListBoxItem Content="2" /><ListBoxItem Content="3" />
                        <ListBoxItem Content="4" /><ListBoxItem Content="5" /><ListBoxItem Content="6" /><ListBoxItem Content="7" />
                        <ListBoxItem Content="8" /><ListBoxItem Content="9" /><ListBoxItem Content="10" /><ListBoxItem Content="11" />
                        <ListBoxItem Content="12" /><ListBoxItem Content="13" /><ListBoxItem Content="14" /><ListBoxItem Content="15" />
                        <ListBoxItem Content="16" />
                        <ListBoxItem Content="17" />
                        <ListBoxItem Content="18" />
                        <ListBoxItem Content="19" />
                        <ListBoxItem Content="20" />
                        <ListBoxItem Content="21" />
                        <ListBoxItem Content="22" />
                        <ListBoxItem Content="23" />
                        <ListBoxItem Content="24" />
                    </ListBox>

                    <!-- Menu Lateral Estilo PowerToys com Dropdowns -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavMenuContainer" Margin="6,0,6,10">
                            <!-- Fixo: Ambientes Virtuais -->
                            <ui:Button x:Name="NavBtn0" Tag="0" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠️" FontSize="15" Width="26" TextAlignment="Center" />
                                    <TextBlock x:Name="NavLbl0" Text="Ambientes Virtuais" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Grupo 1: Acesso Remoto & AD -->
                            <ui:Button Tag="GrpRemotoAd" Click="NavGroupHeader_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,8" Margin="0,6,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🖥️" FontSize="15" TextAlignment="Center" />
                                    <TextBlock x:Name="GrpLblRemotoAd" Grid.Column="1" Text="Acesso Remoto &amp; AD" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GrpChevRemotoAd" Grid.Column="2" Text="⌃" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>
                            <StackPanel x:Name="GrpRemotoAd" Margin="14,0,0,2">
                                <ui:Button x:Name="NavBtn1" Tag="1" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="👤" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl1" Text="Consulta Usuários AD" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn2" Tag="2" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🖥️" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl2" Text="Acesso Remoto" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn22" Tag="22" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🗄️" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl22" Text="Servidores &amp; RDP" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn3" Tag="3" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🗑️" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl3" Text="Limpeza AD &amp; SCCM" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <!-- Grupo 2: Máquina Local & Auditoria -->
                            <ui:Button Tag="GrpLocalAudit" Click="NavGroupHeader_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,8" Margin="0,4,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚡" FontSize="15" TextAlignment="Center" />
                                    <TextBlock x:Name="GrpLblLocalAudit" Grid.Column="1" Text="Máquina Local &amp; Auditoria" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GrpChevLocalAudit" Grid.Column="2" Text="⌄" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>
                            <StackPanel x:Name="GrpLocalAudit" Visibility="Collapsed" Margin="14,0,0,2">
                                <ui:Button x:Name="NavBtn4" Tag="4" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🧹" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl4" Text="Saneamento de Recursos" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn5" Tag="5" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="⚡" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl5" Text="Performance &amp; Auditoria" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn6" Tag="6" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="📦" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl6" Text="Apps &amp; Provisionamento" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn14" Tag="14" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🔧" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl14" Text="Otimizações de Registro" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <!-- Grupo 3: Scripts & Migração (ex-PowerShell) -->
                            <ui:Button Tag="GrpScripts" Click="NavGroupHeader_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,8" Margin="0,4,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="💾" FontSize="15" TextAlignment="Center" />
                                    <TextBlock x:Name="GrpLblScripts" Grid.Column="1" Text="Scripts &amp; Migração" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GrpChevScripts" Grid.Column="2" Text="⌄" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>
                            <StackPanel x:Name="GrpScripts" Visibility="Collapsed" Margin="14,0,0,2">
                                <ui:Button x:Name="NavBtn7" Tag="7" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="📊" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl7" Text="Analisador de Máquina" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn8" Tag="8" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🧼" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl8" Text="Manutenção Remota" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn9" Tag="9" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="👥" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl9" Text="Perfis de Usuários" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn10" Tag="10" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="💾" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl10" Text="Backup &amp; Restore (USMT)" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn19" Tag="19" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🌐" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl19" Text="Mapa de Rota &amp; Ping" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn20" Tag="20" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="📡" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl20" Text="Monitor Zabbix" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn21" Tag="21" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🗺️" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl21" Text="Vizinhos de Rede" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn23" Tag="23" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🖨️" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl23" Text="Print Server &amp; Portas" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <!-- Grupo 4: Bancada Streamlit (Docker & DB) -->
                            <ui:Button Tag="GrpBancada" Click="NavGroupHeader_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,8" Margin="0,4,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🐳" FontSize="15" TextAlignment="Center" />
                                    <TextBlock x:Name="GrpLblBancada" Grid.Column="1" Text="Bancada Streamlit" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GrpChevBancada" Grid.Column="2" Text="⌃" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>
                            <StackPanel x:Name="GrpBancada" Margin="14,0,0,2">
                                <ui:Button x:Name="NavBtn11" Tag="11" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🐳" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl11" Text="Bancada Docker (8501)" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn12" Tag="12" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🎫" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl12" Text="Chamados (OTRS/Cit)" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn13" Tag="13" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="☎️" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl13" Text="Telefonia OXE" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn17" Tag="17" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🖨️" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl17" Text="Impressoras PaperCut" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NavBtn18" Tag="18" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="⏰" FontSize="13" Width="22" TextAlignment="Center" /><TextBlock x:Name="NavLbl18" Text="Agendadores &amp; Cron" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <Separator Margin="4,8" />

                            <!-- Fixo Rodapé: Documentação, Logs & Configurações -->
                            <ui:Button x:Name="NavBtn24" Tag="24" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,1">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="📚" FontSize="15" Width="26" TextAlignment="Center" /><TextBlock x:Name="NavLbl24" Text="Documentação" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="NavBtn15" Tag="15" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,1">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="📜" FontSize="15" Width="26" TextAlignment="Center" /><TextBlock x:Name="NavLbl15" Text="Logs da Aplicação" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="NavBtn16" Tag="16" Click="NavMenuItem_Click" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,1">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙️" FontSize="15" Width="26" TextAlignment="Center" /><TextBlock x:Name="NavLbl16" Text="Configurações &amp; Credenciais" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Divisor Arrastável (GridSplitter para redimensionar o menu à vontade) -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

            <!-- Área de Conteúdo Principal Alternável -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid Margin="20">
                    
                    <!-- PAINEL 0: AMBIENTES VIRTUAIS -->
                    <Grid x:Name="PanelAmbientes" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Ambientes Virtuais &amp; Modos de Trabalho" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Clique no card para iniciar o fluxo completo imediatamente ou na seta (⌄) à direita para personalizar as etapas e acompanhar o console." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ItemsAmbientes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <!-- Cabeçalho do Card (Clique no corpo executa direto; seta à direita expande dropdown) -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="EnvCard_MouseLeftButtonUp" ToolTip="Clique no card para executar o fluxo imediatamente" Margin="0,0,12,0">
                                                            <StackPanel>
                                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <Border Background="#1e3a8a" CornerRadius="4" Padding="8,2" Margin="0,2,8,2">
                                                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="#93c5fd" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                                </WrapPanel>
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Appearance="Secondary" Content="{Binding ChevronSymbol}" Tag="{Binding}" Click="BtnToggleEnvDropdown_Click" Width="38" Height="36" Padding="0" FontSize="15" ToolTip="Expandir/recolher etapas do fluxo e console" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Dropdown de Etapas + Botão Executar + Console -->
                                                    <StackPanel Visibility="{Binding DetailsVisibility}" Margin="0,12,0,0">
                                                        <Separator Margin="0,0,0,10" />

                                                        <Grid Margin="0,0,0,8">
                                                            <TextBlock Text="Etapas do Fluxo (desmarque para pular):" FontSize="12" FontWeight="SemiBold" Foreground="#38bdf8" VerticalAlignment="Center" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <ui:Button Content="Marcar Todas" Appearance="Transparent" Tag="{Binding}" Click="BtnEnvSelectAllSteps_Click" Padding="8,3" FontSize="11.5" Margin="0,0,4,0" />
                                                                <ui:Button Content="Desmarcar" Appearance="Transparent" Tag="{Binding}" Click="BtnEnvDeselectAllSteps_Click" Padding="8,3" FontSize="11.5" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{Binding Steps}" Margin="4,0,0,10">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,2">
                                                                        <WrapPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Category, StringFormat='[{0}] '}" FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8" />
                                                                            <TextBlock Text="{Binding Label}" FontSize="12.5" />
                                                                        </WrapPanel>
                                                                    </CheckBox>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <ui:Button Appearance="Primary" Content="{Binding RunButtonText}" Icon="{ui:SymbolIcon Symbol=Play24}" Tag="{Binding}" Click="BtnRunEnvMode_Click" IsEnabled="{Binding CanRun}" Padding="16,8" HorizontalAlignment="Left" />

                                                        <!-- Console em Tempo Real do Fluxo -->
                                                        <Border Visibility="{Binding ConsoleVisibility}" Margin="0,12,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="6" Padding="10">
                                                            <StackPanel>
                                                                <TextBlock Text="Console de Execução do Ambiente" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8" Margin="0,0,0,4" />
                                                                <TextBox Text="{Binding ConsoleLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="#34d399" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" MaxHeight="180" VerticalScrollBarVisibility="Auto" Padding="0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- PAINEL 1: ACESSO REMOTO -->
                    <Grid x:Name="PanelRemoto" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Central de Acesso Remoto &amp; Diagnóstico" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Pesquise por nome da máquina (ex: 80600) ou usuário logado (ex: usuario.sobrenome) com correspondência ampla." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Barra de Consulta Ampla -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox x:Name="TxtComputerName" Grid.Column="0" PlaceholderText="Pesquise por máquina (ex: 80600 ou DOMINIO-80600) ou usuário conectado (ex: usuario.sobrenome)..." Margin="0,0,10,0" KeyDown="TxtComputerName_KeyDown" Height="38" />
                                <ui:Button x:Name="BtnConsultarRemoto" Grid.Column="1" Appearance="Primary" Content="Pesquisar" Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnConsultarRemoto_Click" Padding="18,9" />
                            </Grid>
                        </Border>

                        <!-- Conteúdo Scrollável: Lista de Resultados + Console de Diagnóstico -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                            <StackPanel>

                                <!-- Card de Placeholder (Antes da consulta) -->
                                <Border x:Name="PlaceholderRemoteCard" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="30" Margin="0,0,0,12" Visibility="Visible">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                        <TextBlock Text="Pesquisa Ampla de Máquinas &amp; Usuários" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Digite parte do nome da máquina (ex: 80600), o nome completo (DOMINIO-80600) ou o usuário conectado (ex: usuario.sobrenome) para localizar dispositivos, status de rede e registros do AD &amp; SCCM." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="620" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Card de Carregamento (Durante a consulta) -->
                                <Border x:Name="LoadingRemoteCard" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="25" Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⏳" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="Pesquisando no Active Directory, Configuration Manager e diagnosticando rede..." FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Aguarde enquanto verificamos os dispositivos correspondentes e seus usuários." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Lista de Resultados Dinâmicos (ItemsControl) -->
                                <ItemsControl x:Name="ItemsMachineResults">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Cabeçalho do Card: Badge, Nome, Ações Rápidas -->
                                                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <Border CornerRadius="4" Padding="8,3" Margin="0,2,10,2" Background="{Binding OnlineBadgeBackground}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding OnlineBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding OnlineBadgeForeground}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding ComputerName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                            <ui:Button Appearance="Transparent" ToolTip="Copiar Nome da Máquina" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnCardCopyMachine_Click" Width="30" Height="30" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding DnsHostName}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                                        <WrapPanel Orientation="Horizontal">
                                                            <ui:Button Appearance="Primary" Content="Acessar CmRcViewer" Icon="{ui:SymbolIcon Symbol=Headset24}" Click="BtnCardConnectSccm_Click" Margin="0,0,8,6" Padding="14,8" />
                                                            <ui:Button Appearance="Secondary" Content="Acessar RDP" Icon="{ui:SymbolIcon Symbol=Window24}" Click="BtnCardConnectRdp_Click" Margin="0,0,8,6" Padding="14,8" />
                                                            <ui:Button Appearance="Secondary" Content="Explorador (C$)" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Click="BtnCardOpenExplorer_Click" ToolTip="Abrir \\máquina\c$ diretamente com credencial Admin" Margin="0,0,0,6" Padding="14,8" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <Separator Grid.Row="1" Margin="0,0,0,14" />

                                                    <!-- Corpo: 3 Colunas de Dados -->
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Bloco 1: Sessão & Usuários -->
                                                        <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                                            <StackPanel>
                                                                <TextBlock Text="👤 SESSÃO &amp; USUÁRIO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                                                <TextBlock Text="Usuário Conectado Atualmente:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Grid Margin="0,2,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding CurrentLogonUserDisplay}" FontSize="14" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <ui:Button Grid.Column="1" Appearance="Transparent" ToolTip="Copiar Usuário Conectado" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnCardCopyUser_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                </Grid>

                                                                <TextBlock Text="Usuário Primário (Dono):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding PrimaryUserDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />

                                                                <TextBlock Text="Endereço IP &amp; Latência:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Grid Margin="0,2,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding IpWithLatency}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <ui:Button Appearance="Transparent" ToolTip="Copiar Endereço IP" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnCardCopyIp_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                        <ui:Button Appearance="Transparent" Content="🌐" ToolTip="Traçar Rota &amp; Ping no Mapa Visual" Click="BtnCardTraceRoute_Click" Width="28" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Text="Localidade Provável (Setor / Sala / OU):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding EstimatedLocationDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#38bdf8" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Bloco 2: Active Directory -->
                                                        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                                            <StackPanel>
                                                                <TextBlock Text="🏛️ ACTIVE DIRECTORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                                                <TextBlock Text="Sistema Operacional:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding OperatingSystem}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />

                                                                <TextBlock Text="Criado em:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding WhenCreated}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10" />

                                                                <TextBlock Text="Unidade Organizacional (OU):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding DistinguishedName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DistinguishedName}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Bloco 3: Configuration Manager (SCCM) -->
                                                        <Border Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14">
                                                            <StackPanel>
                                                                <TextBlock Text="📡 CONFIGURATION MANAGER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                                                <TextBlock Text="Atividade do Agente SCCM:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ClientStatus}" FontSize="13" FontWeight="SemiBold" Foreground="#34d399" Margin="0,2,0,10" />

                                                                <TextBlock Text="MAC Address:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Grid Margin="0,2,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding MacAddressDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#f59e0b" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <ui:Button Grid.Column="1" Appearance="Transparent" ToolTip="Copiar MAC Address" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnCardCopyMac_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                </Grid>

                                                                <TextBlock Text="ResourceID:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ResourceId}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,10" />

                                                                <TextBlock Text="SMSID (GUID):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding SmsId}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SmsId}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Console de Log para Diagnóstico de Conexão -->
                                <Border Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="80" MaxHeight="130">
                                    <RichTextBox x:Name="RichRemoteLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" VerticalScrollBarVisibility="Auto">
                                        <FlowDocument />
                                    </RichTextBox>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- PAINEL 2: LIMPEZA AD & SCCM -->
                    <Grid x:Name="PanelAdSccm" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Consulta &amp; Desprovisionamento (AD &amp; SCCM)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Consulte se a máquina está cadastrada nas bases (busca por nome ou parte, ex: 80600) ou efetue a exclusão direta para permitir reformatação via PXE." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Máquina Alvo:" FontWeight="Medium" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="TxtAdTargetComputer" PlaceholderText="Ex: 80600 ou DOMINIO-80600" Margin="0,0,0,10" KeyDown="TxtAdTargetComputer_KeyDown" />
                                <WrapPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnAdQuery" Appearance="Secondary" Content="Consultar Máquina" Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnAdQuery_Click" Margin="0,0,10,4" />
                                    <ui:Button x:Name="BtnAdClean" Appearance="Danger" Content="Excluir do AD &amp; SCCM" Icon="{ui:SymbolIcon Symbol=Delete24}" Click="BtnAdClean_Click" Margin="0,0,0,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Margin="0,20,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichAdLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="13" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 3: SANEAMENTO -->
                    <Grid x:Name="PanelSaneamento" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Selecione o que Fechar e Otimizar" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Defina exatamente o que deve ser encerrado ou mantido durante o saneamento." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                    <CheckBox x:Name="ChkOffice" Content="Salvar e Fechar Office (Word/Excel)" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkBrowsers" Content="Fechar Chrome &amp; Edge" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkFirefox" Content="Fechar Firefox Atual" IsChecked="False" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkTeams" Content="Fechar Microsoft Teams" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkAdminTools" Content="Fechar Consoles AD, SCCM e SAJMP" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkUtilities" Content="Fechar FoxitPDF, Bloco de Notas e Relógio" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkTelemetry" Content="Parar Telemetria (CompatTelRunner)" IsChecked="True" Margin="0,0,24,12" />
                                    <CheckBox x:Name="ChkRestartExplorer" Content="Reiniciar Explorador de Arquivos (Modo Nuclear)" IsChecked="False" Margin="0,0,24,12" />
                                </WrapPanel>

                                <Separator Grid.Row="1" Margin="0,5,0,15" />

                                <ui:Button x:Name="BtnLimparAmbiente" Grid.Row="2" Appearance="Primary" Content="Executar Limpeza com Itens Selecionados" Icon="{ui:SymbolIcon Symbol=Broom24}" Click="BtnLimparAmbiente_Click" Padding="18,10" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Margin="0,15,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichCleanLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="13" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 4: PERFORMANCE & AUDITORIA -->
                    <Grid x:Name="PanelPerformance" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Auditoria de Lentidão &amp; Otimização (Debloat)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Diagnóstico nativo de RAM, bloatwares, TRIM, hibernação e WSL/Docker com aplicação direta em C#." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Cartões de Resumo Rápido (KPIs da Auditoria) -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Memória RAM Livre" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPerfRamKpi" Text="Aguardando auditoria" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Disco C: &amp; Hibernação" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPerfDiskKpi" Text="Aguardando auditoria" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Status SSD TRIM" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPerfTrimKpi" Text="Aguardando auditoria" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Bloatwares UWP" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPerfBloatKpi" Text="Aguardando auditoria" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Opções de Otimização & Ações -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                    <CheckBox x:Name="ChkOptTelemetryServices" Content="Desativar Serviços Telemetria (DiagTrack/SysMain/WerSvc)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptTelemetryReg" Content="Desativar Telemetria &amp; Anúncios no Registro" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptBloatApps" Content="Remover Bloatware Apps (UWP + DISM)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptHibernation" Content="Desativar Hibernação (remover C:\hiberfil.sys)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptTrim" Content="Ativar TRIM em SSDs (fsutil)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptBingSearch" Content="Desativar Busca Web (Bing) no Menu Iniciar" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptUiSpeed" Content="Acelerar Menus da Interface (MenuShowDelay 50ms)" IsChecked="True" Margin="0,0,20,10" />
                                    <CheckBox x:Name="ChkOptDockerCache" Content="Limpar Cache do Docker (Builder &amp; Órfãos)" IsChecked="True" Margin="0,0,20,10" ToolTip="Executa 'docker builder prune' e 'system prune' liberando cache sem apagar suas imagens ativas ou volumes." />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,10">
                                        <CheckBox x:Name="ChkOptWslConfig" Content="Limitar RAM do WSL 2 (.wslconfig):" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="CmbWslMemory" SelectedIndex="2" Width="90" Height="32">
                                            <ComboBoxItem Content="2GB" />
                                            <ComboBoxItem Content="3GB" />
                                            <ComboBoxItem Content="4GB" />
                                            <ComboBoxItem Content="6GB" />
                                            <ComboBoxItem Content="8GB" />
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>

                                <Separator Grid.Row="1" Margin="0,4,0,12" />

                                <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                    <ui:Button x:Name="BtnExecutarAuditoria" Appearance="Primary" Content="Executar Auditoria Completa" Icon="{ui:SymbolIcon Symbol=Pulse24}" Click="BtnExecutarAuditoria_Click" Margin="0,0,10,6" Padding="16,9" />
                                    <ui:Button x:Name="BtnAplicarOtimizacao" Appearance="Success" Content="Aplicar Otimizações Selecionadas" Icon="{ui:SymbolIcon Symbol=Flash24}" Click="BtnAplicarOtimizacao_Click" Margin="0,0,10,6" Padding="16,9" />
                                    <ui:Button x:Name="BtnReverterServicos" Appearance="Secondary" Content="Reverter Serviços (Rollback)" Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" Click="BtnReverterServicos_Click" Margin="0,0,0,6" Padding="14,9" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Terminal de Diagnóstico e Aplicação -->
                        <Border Grid.Row="3" Margin="0,12,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichPerformanceLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="13" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 5: APPS INSTALADOS & PROVISIONAMENTO -->
                    <Grid x:Name="PanelApps" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="170" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Apps Instalados &amp; Provisionamento Pós-Formatação" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Detecta consoles administrativos corporativos (AD MMC / SCCM) e prepara futuros pacotes via winget (source winget)." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Barra de Opções -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkInstallSilent" Grid.Column="0" Content="Instalação Silenciosa automática (/q /quiet --silent)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ui:Button x:Name="BtnVerificarApps" Grid.Column="1" Appearance="Primary" Content="Atualizar Status dos Apps" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Click="BtnVerificarApps_Click" Padding="14,8" />
                            </Grid>
                        </Border>

                        <!-- Listagem de Softwares -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LstSoftwareCatalog">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Ícone Emoji do App no canto esquerdo -->
                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding IconEmoji}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Detalhes do Software -->
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,10,2" VerticalAlignment="Center" />
                                                        <Border Background="#1e293b" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="0,2,0,2">
                                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#94a3b8" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="#94a3b8" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- Ações no canto direito -->
                                                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <!-- Badge Instalado (Versão Atual) -->
                                                    <Border Visibility="{Binding InstalledBadgeVisibility}" Background="#1a34d399" BorderBrush="#4d34d399" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#34d399" FontSize="16" Margin="0,0,6,0" />
                                                            <TextBlock Text="Instalado" FontSize="12" FontWeight="SemiBold" Foreground="#34d399" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Botão Atualizar (Quando há nova versão detectada) -->
                                                    <ui:Button Visibility="{Binding UpdateButtonVisibility}" IsEnabled="{Binding CanClickInstall}" Content="Atualizar" Appearance="Success" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Tag="{Binding}" Click="BtnInstallSoftware_Click" Margin="0,0,8,0" Padding="14,7" ToolTip="Atualizar para a versão mais recente via winget" />

                                                    <!-- Botão Instalar (Quando não instalado) -->
                                                    <ui:Button Visibility="{Binding InstallButtonVisibility}" IsEnabled="{Binding CanClickInstall}" Content="{Binding InstallButtonText}" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Tag="{Binding}" Click="BtnInstallSoftware_Click" Margin="0,0,8,0" Padding="14,7" />

                                                    <!-- Botão Desinstalar (Casos extremos) -->
                                                    <ui:Button Visibility="{Binding UninstallButtonVisibility}" IsEnabled="{Binding CanClickInstall}" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Delete24}" Tag="{Binding}" Click="BtnUninstallSoftware_Click" Padding="10,7" ToolTip="Desinstalar este software da máquina" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Terminal de Instalação -->
                        <Border Grid.Row="3" Margin="0,12,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichAppsLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="13" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 6: ANALISADOR DE DISPOSITIVOS REMOTOS -->
                    <Grid x:Name="PanelAnalisador" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Analisador Completo de Dispositivos (HTML, PDF &amp; Excel)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Coleta completa de Hardware, BIOS, RAM (JEDEC), Monitores (EDID), Discos, Impressoras, Perfis, Programas, Serviços, Processos e Drivers em C# nativo." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Máquina Alvo (use '.' para analisar a máquina local):" FontWeight="Medium" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="TxtAnalyzerComputer" Text="." PlaceholderText="Ex: . (local), DOMINIO-80600 ou 10.x.x.x" Margin="0,0,0,10" KeyDown="TxtAnalyzerComputer_KeyDown" />
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button x:Name="BtnRunAnalyzer" Appearance="Primary" Content="Analisar &amp; Gerar Relatórios" Icon="{ui:SymbolIcon Symbol=DataHistogram24}" Click="BtnRunAnalyzer_Click" Margin="0,0,8,6" />
                                    <ui:Button x:Name="BtnOpenReportFolder" Appearance="Secondary" Content="Abrir Pasta DeviceReports" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Click="BtnOpenReportFolder_Click" Margin="0,0,0,6" />
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" Margin="0,2,0,8">
                                    <CheckBox x:Name="ChkAnalyzerOpenFirefox" Content="Abrir relatório HTML automaticamente no Firefox" IsChecked="True" Margin="0,0,20,4" />
                                    <CheckBox x:Name="ChkAnalyzerSkipMajor" Content="Modo Rápido (pular Programas, Serviços, Processos e Drivers)" IsChecked="False" Margin="0,0,0,4" />
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:Button x:Name="BtnOpenReportHtml" Appearance="Secondary" Content="🌐 Abrir Último HTML no Firefox" Click="BtnOpenReportHtml_Click" IsEnabled="False" Margin="0,0,8,6" Padding="10,6" />
                                    <ui:Button x:Name="BtnOpenReportPdf" Appearance="Secondary" Content="📄 Abrir Último PDF" Click="BtnOpenReportPdf_Click" IsEnabled="False" Margin="0,0,8,6" Padding="10,6" />
                                    <ui:Button x:Name="BtnOpenReportExcel" Appearance="Secondary" Content="📊 Abrir Último Excel (.xlsx)" Click="BtnOpenReportExcel_Click" IsEnabled="False" Margin="0,0,0,6" Padding="10,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- KPIs Resumo da Máquina Analisada -->
                        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Computador / Modelo" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtAnlKpiModel" Text="Aguardando coleta..." FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Usuário Logado (AD)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtAnlKpiUser" Text="-" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Sistema &amp; Memória RAM" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtAnlKpiOs" Text="-" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Armazenamento &amp; Monitores" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtAnlKpiDisk" Text="-" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="3" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichAnalyzerLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 7: MANUTENÇÃO & LIMPEZA REMOTA -->
                    <Grid x:Name="PanelLimpezaRemota" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Manutenção &amp; Limpeza de Caches (Local ou Remota)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Inspecione primeiro o espaço ocupado pelos caches na máquina alvo e execute a limpeza seletiva e reparo de sistema em C# nativo." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Máquina Alvo (use '.' para local ou informe o hostname/IP remoto):" FontWeight="Medium" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <ui:TextBox x:Name="TxtRemoteMaintComputer" Text="." PlaceholderText="Ex: . (local) ou NOME-DA-MAQUINA" Margin="0,0,0,10" KeyDown="TxtRemoteMaintComputer_KeyDown" />
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:Button x:Name="BtnAnalyzeRemoteMaint" Appearance="Secondary" Content="Analisar Espaço &amp; Caches" Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnAnalyzeRemoteMaint_Click" Margin="0,0,10,6" />
                                    <ui:Button x:Name="BtnExecuteRemoteMaint" Appearance="Primary" Content="Executar Limpeza &amp; Manutenção" Icon="{ui:SymbolIcon Symbol=Broom24}" Click="BtnExecuteRemoteMaint_Click" Margin="0,0,0,6" />
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkRmTemp" Content="Arquivos Temp (Usuários &amp; Windows)" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmPrefetch" Content="Cache Prefetch (C:\Windows\Prefetch)" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmRecycle" Content="Esvaziar Lixeira ($Recycle.Bin)" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmWuCache" Content="Cache Windows Update (Download)" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmCbs" Content="Truncar Logs CBS (C:\Windows\Logs\CBS)" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmThumbnails" Content="Cache de Miniaturas (thumbcache)" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmDeliveryOpt" Content="Cache Delivery Optimization" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmCrashDumps" Content="Relatórios WER &amp; CrashDumps" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmStore" Content="Cache Microsoft Store (LocalCache)" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmEventLogs" Content="Logs de Eventos (Admin/Operational)" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmDns" Content="Flush DNS (ipconfig /flushdns)" IsChecked="True" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmWinSxS" Content="Limpeza WinSxS (DISM Cleanup)" IsChecked="False" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmWindowsOld" Content="Remover Windows.old / $Windows.~BT" IsChecked="False" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmRepairVol" Content="Reparar Volume C: (Repair-Volume)" IsChecked="False" Margin="0,2,18,4" />
                                    <CheckBox x:Name="ChkRmDefragHdd" Content="Desfragmentar C: (somente se HDD)" IsChecked="False" Margin="0,2,18,4" />
                                </WrapPanel>
                                <CheckBox x:Name="ChkRmSfc" Content="Verificar Corrupção de Imagem (DISM CheckHealth + SFC /scannow se necessário)" IsChecked="False" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- KPIs de Espaço em Disco -->
                        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,12">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Espaço Livre em C: (Antes)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtRmFreeBefore" Text="-" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Potencial Estimado em Caches" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtRmCleanableEstimate" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="#38bdf8" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Espaço Livre (Depois) &amp; Recuperado" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtRmFreeAfter" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="#10b981" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="3" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <RichTextBox x:Name="RichRemoteMaintLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 8: LIMPEZA DE PERFIS DE USUÁRIOS REMOTOS -->
                    <Grid x:Name="PanelPerfisRemotos" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="165" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Análise &amp; Limpeza de Perfis de Usuários (Local ou Remota)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Analise os perfis gravados em C:\Users (com consulta AD, último uso e espaço em GB) e remova com segurança perfis inativos." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Máquina Alvo:" FontWeight="Medium" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="TxtRemoteProfilesComputer" Text="." PlaceholderText="Ex: . (local) ou DOMINIO-80600" Margin="0,0,0,10" KeyDown="TxtRemoteProfilesComputer_KeyDown" />
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:Button x:Name="BtnQueryRemoteProfiles" Appearance="Secondary" Content="Analisar Perfis na Máquina" Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnQueryRemoteProfiles_Click" Margin="0,0,10,6" />
                                    <ui:Button x:Name="BtnPurgeRemoteProfiles" Appearance="Danger" Content="Remover Perfis Selecionados" Icon="{ui:SymbolIcon Symbol=Delete24}" Click="BtnPurgeRemoteProfiles_Click" Margin="0,0,0,6" />
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtManualProfilesToPurge" Grid.Column="0" PlaceholderText="Opcional: digite usuários adicionais separados por vírgula" Margin="0,0,10,0" />
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="BtnSelectAllInactiveProfiles" Appearance="Secondary" Content="Marcar Inativos" Click="BtnSelectAllInactiveProfiles_Click" Margin="0,0,8,0" Padding="10,6" />
                                        <ui:Button x:Name="BtnClearProfileSelection" Appearance="Secondary" Content="Desmarcar Todos" Click="BtnClearProfileSelection_Click" Padding="10,6" />
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Lista Interativa de Perfis Encontrados -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TxtProfilesListHeader" Grid.Row="0" Text="Perfis encontrados na máquina (clique em 'Analisar Perfis na Máquina' para listar):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ItemsRemoteProfiles">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.5*" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="75" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanBeRemoved}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Usuario}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding CaminhoPerfil}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                            <TextBlock Text="{Binding Nome}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Escritorio}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                            <TextBlock Text="Último Uso:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{Binding UltimoUso}" FontSize="11" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="4" Text="{Binding EspacoDiscoTexto}" FontWeight="Bold" FontSize="13" Foreground="#38bdf8" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <Border Visibility="{Binding ActiveBadgeVisibility}" Background="#1410b981" BorderBrush="#10b981" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                                <TextBlock Text="🔒 Logado (Protegido)" FontSize="11" Foreground="#10b981" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Visibility="{Binding RemovableBadgeVisibility}" Background="#1464748b" BorderBrush="#64748b" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                                <TextBlock Text="Inativo (Removível)" FontSize="11" Foreground="#94a3b8" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="12">
                            <RichTextBox x:Name="RichRemoteProfilesLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" VerticalScrollBarVisibility="Auto">
                                <FlowDocument />
                            </RichTextBox>
                        </Border>
                    </Grid>

                    <!-- PAINEL 9: CONSULTA DE USUÁRIOS ACTIVE DIRECTORY -->
                    <Grid x:Name="PanelUsuariosAd" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Consulta de Usuários no Active Directory" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Pesquise por login (ex: usuario.sobrenome), nome completo, e-mail, setor, cargo ou matrícula com carregamento assíncrono completo." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Barra de Consulta Ampla de Usuários AD -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox x:Name="TxtAdUserQuery" Grid.Column="0" PlaceholderText="Pesquise por login (ex: usuario.sobrenome), nome completo, e-mail, departamento ou matrícula..." Margin="0,0,10,0" KeyDown="TxtAdUserQuery_KeyDown" Height="38" />
                                <ui:Button x:Name="BtnConsultarUsuarioAd" Grid.Column="1" Appearance="Primary" Content="Consultar no AD" Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnConsultarUsuarioAd_Click" Padding="18,9" />
                            </Grid>
                        </Border>

                        <!-- Barra de Paginação, Filtros em Tempo Real & Navegação Rápida -->
                        <Border x:Name="BorderAdUserPagination" Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Linha 0: Controles de Filtros Rápidos Locais (Departamento, Status da Conta e Pesquisa Instantânea) -->
                                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:TextBox x:Name="TxtAdUserLocalFilter" PlaceholderText="Filtrar por nome, cargo, matrícula, e-mail..." TextChanged="TxtAdUserLocalFilter_TextChanged" MinWidth="220" Margin="0,0,8,6" Height="34" />
                                    <ComboBox x:Name="CmbAdUserDeptFilter" SelectionChanged="CmbAdUserFilter_SelectionChanged" MinWidth="180" MaxWidth="230" Margin="0,0,8,6" Height="34" />
                                    <ComboBox x:Name="CmbAdUserStatusFilter" SelectionChanged="CmbAdUserFilter_SelectionChanged" Width="170" Margin="0,0,8,6" Height="34">
                                        <ComboBoxItem Content="Todos os Status" />
                                        <ComboBoxItem Content="🟢 Apenas Ativas" />
                                        <ComboBoxItem Content="🔒 Apenas Bloqueadas" />
                                        <ComboBoxItem Content="🔴 Apenas Desativadas" />
                                        <ComboBoxItem Content="🟡 Troca de Senha" />
                                    </ComboBox>
                                    <ui:Button x:Name="BtnClearAdUserFilters" Content="Limpar Filtros" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Click="BtnClearAdUserFilters_Click" Margin="0,0,0,6" Padding="10,6" />
                                </WrapPanel>

                                <Separator Grid.Row="1" Margin="0,0,0,8" />

                                <!-- Linha 2: Indicador de Paginação e Botões Anterior / Próxima -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtAdUserPaginationSummary" Grid.Column="0" Text="Mostrando página 1 de 1" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="BtnAdUserPrevPage" Content="Anterior" Icon="{ui:SymbolIcon Symbol=ArrowLeft24}" Click="BtnAdUserPrevPage_Click" Margin="0,0,8,0" Padding="12,6" />
                                        <TextBlock x:Name="TxtAdUserCurrentPageNumber" Text="Página 1 / 1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,14,0" />
                                        <ui:Button x:Name="BtnAdUserNextPage" Content="Próxima" Icon="{ui:SymbolIcon Symbol=ArrowRight24}" Click="BtnAdUserNextPage_Click" Padding="12,6" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Conteúdo Scrollável: Lista de Fichas de Usuários + Console de Diagnóstico LDAP -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel>

                                <!-- Card de Placeholder (Antes da consulta) -->
                                <Border x:Name="PlaceholderAdUserCard" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="30" Margin="0,0,0,12" Visibility="Visible">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🪪" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                        <TextBlock Text="Consulta Completa de Identidades &amp; Grupos no AD" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Digite parte do login (ex: usuario.sobrenome), o nome do servidor/colaborador, e-mail ou departamento para inspecionar status da conta, bloqueios, datas de último logon, expiração de senha, OU e todos os grupos de segurança (memberOf)." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="650" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Card de Carregamento (Durante a consulta assíncrona) -->
                                <Border x:Name="LoadingAdUserCard" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="25" Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⏳" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="Consultando controlador de domínio Active Directory (LDAP)..." FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Aguarde enquanto coletamos atributos organizacionais, políticas de senha, contadores de logon e grupos." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Lista de Resultados Dinâmicos de Usuários (ItemsControl) -->
                                <ItemsControl x:Name="ItemsAdUserResults">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Cabeçalho do Card: Badge de Status, Nome Completo, Login/UPN e Ações Rápidas -->
                                                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <Border CornerRadius="4" Padding="8,3" Margin="0,2,10,2" Background="{Binding StatusBadgeBackground}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeForeground}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding HeaderNameDisplay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <ui:Button Appearance="Transparent" ToolTip="Copiar Login (sAMAccountName)" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnAdUserCopyLogin_Click" Width="30" Height="30" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding SamAndUpnDisplay}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                                        <WrapPanel Orientation="Horizontal">
                                                            <ui:Button Appearance="Primary" Content="Buscar Máquinas deste Usuário" Icon="{ui:SymbolIcon Symbol=Window24}" Click="BtnAdUserFindMachines_Click" ToolTip="Pesquisar estações onde este usuário está conectado no módulo de Acesso Remoto" Margin="0,0,8,6" Padding="14,8" />
                                                            <ui:Button Appearance="Secondary" Content="Copiar Ficha Completa" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnAdUserCopyFullDossier_Click" ToolTip="Copiar todos os dados do usuário para a Área de Transferência" Margin="0,0,8,6" Padding="14,8" />
                                                            <ui:Button Appearance="Secondary" Content="Copiar Grupos" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnAdUserCopyGroups_Click" ToolTip="Copiar lista de grupos (memberOf) do usuário" Margin="0,0,0,6" Padding="14,8" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <Separator Grid.Row="1" Margin="0,0,0,14" />

                                                    <!-- Corpo: 3 Colunas de Dados do Active Directory -->
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Bloco 1: Identificação, Contato & Lotação -->
                                                        <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                                            <StackPanel>
                                                                <TextBlock Text="👤 IDENTIFICAÇÃO &amp; LOTAÇÃO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                                                <TextBlock Text="Login de Rede (sAMAccountName):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Grid Margin="0,2,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding SamAccountName}" FontSize="14" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <ui:Button Grid.Column="1" Appearance="Transparent" ToolTip="Copiar Login" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnAdUserCopyLogin_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                </Grid>

                                                                <TextBlock Text="E-mail Corporativo:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Grid Margin="0,2,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding MailDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding MailDisplay}" />
                                                                    <ui:Button Grid.Column="1" Appearance="Transparent" ToolTip="Copiar E-mail" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnAdUserCopyMail_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                </Grid>

                                                                <TextBlock Text="Cargo / Função:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding TitleDisplay}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />

                                                                <TextBlock Text="Departamento / Lotação / Órgão:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding DepartmentAndOfficeDisplay}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />

                                                                <TextBlock Text="Telefones &amp; Matrícula:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding PhonesDisplay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />

                                                                <TextBlock Text="Descrição (AD):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding DescriptionDisplay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Bloco 2: Segurança, Senha & Auditoria -->
                                                        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                                            <StackPanel>
                                                                <TextBlock Text="🔐 SEGURANÇA, SENHA &amp; SESSÃO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                                                <TextBlock Text="Política de Senha &amp; Controle (UAC):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding PasswordPolicyDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#34d399" Margin="0,2,0,8" TextWrapping="Wrap" />

                                                                <TextBlock Text="Último Logon no Domínio:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding LastLogonDisplay}" FontSize="13" FontWeight="Bold" Foreground="#38bdf8" Margin="0,2,0,8" />

                                                                <TextBlock Text="Última Alteração de Senha (pwdLastSet):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding PasswordLastSetDisplay}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,8" />

                                                                <TextBlock Text="Expiração da Conta:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding AccountExpiresDisplay}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,8" />

                                                                <TextBlock Text="Contadores de Autenticação:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding AuditCountersDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#f59e0b" Margin="0,2,0,8" />

                                                                <TextBlock Text="Gestor / Responsável (Manager):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ManagerDisplay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ManagerDn}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Bloco 3: Diretório, Caminhos & Grupos (memberOf) -->
                                                        <Border Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14">
                                                            <StackPanel>
                                                                <TextBlock Text="🏛️ DIRETÓRIO, PERFIL &amp; GRUPOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />

                                                                <TextBlock Text="Criação &amp; Última Modificação:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding CreatedAndChangedDisplay}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />

                                                                <TextBlock Text="Unidade Organizacional (OU / DN):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Grid Margin="0,2,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding OrganizationalUnitDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DistinguishedName}" />
                                                                    <ui:Button Grid.Column="1" Appearance="Transparent" ToolTip="Copiar Distinguished Name (DN) Completo" Icon="{ui:SymbolIcon Symbol=Copy24}" Click="BtnAdUserCopyDn_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" />
                                                                </Grid>

                                                                <TextBlock Text="Script de Logon &amp; Diretório Base:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ProfileAndPathsDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />

                                                                <TextBlock Text="{Binding GroupsHeaderDisplay}" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,4" />
                                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" MaxHeight="110">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                        <TextBox Text="{Binding GroupsDisplay, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Console de Log para Diagnóstico de Consulta LDAP -->
                                <Border Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="80" MaxHeight="130">
                                    <RichTextBox x:Name="RichAdUsersLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" VerticalScrollBarVisibility="Auto">
                                        <FlowDocument />
                                    </RichTextBox>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- PAINEL 10: CONFIGURAÇÕES & COFRE -->
                    <Grid x:Name="PanelConfig" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Parâmetros do Sistema &amp; Credenciais" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Gerencie cofres DPAPI seguros, URLs corporativas, servidores do SCCM e tipografia." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <!-- Seção de Cofres e Credenciais XML -->
                                    <TextBlock Text="Cofre de Credenciais (DPAPI .xml)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="Geração e teste das credenciais seguras usadas nos scripts e rotinas administrativas." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:Button x:Name="BtnCheckAdminXml" Appearance="Secondary" Content="Verificar Credencial Local (XML)" Icon="{ui:SymbolIcon Symbol=ShieldKeyhole24}" Click="BtnCheckAdminXml_Click" Margin="0,0,10,8" Padding="14,10" />
                                        <ui:Button x:Name="BtnCheckAdminAdXml" Appearance="Secondary" Content="Verificar Credencial AD (XML)" Icon="{ui:SymbolIcon Symbol=ShieldKeyhole24}" Click="BtnCheckAdminAdXml_Click" Margin="0,0,10,8" Padding="14,10" />
                                        <ui:Button x:Name="BtnCriarAdminAdXml" Appearance="Primary" Content="Criar/Atualizar Cofre AD (XML)" Icon="{ui:SymbolIcon Symbol=Key24}" Click="BtnCriarAdminAdXml_Click" Margin="0,0,0,8" Padding="14,10" />
                                    </WrapPanel>

                                    <!-- Console de Log para operações com o cofre -->
                                    <Border Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15" MinHeight="90" MaxHeight="130">
                                        <RichTextBox x:Name="RichScriptsLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" VerticalScrollBarVisibility="Auto">
                                            <FlowDocument />
                                        </RichTextBox>
                                    </Border>

                                    <Separator Margin="0,5,0,15" />

                                    <!-- Inicialização com o Windows & Bandeja -->
                                    <TextBlock Text="Inicialização &amp; Sistema" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                                    
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Iniciar junto com o Windows" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Inicia automaticamente o Ambientes Hub após o boot e login do usuário." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ui:ToggleSwitch x:Name="ToggleStartWithWindows" Grid.Column="1" VerticalAlignment="Center" Click="ToggleStartWithWindows_Click" />
                                        </Grid>
                                    </Border>

