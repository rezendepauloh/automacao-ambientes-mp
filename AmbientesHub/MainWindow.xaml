                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <ui:Button x:Name="BtnImpressorasPrevPage" Content="← Anterior" Appearance="Secondary" Click="BtnImpressorasPrevPage_Click" IsEnabled="False" Padding="12,6" Margin="0,0,10,0" />
                                    <TextBlock x:Name="TxtImpressorasPageInfo" Text="Página 1 de 1 (0 impressoras)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
                                    <ui:Button x:Name="BtnImpressorasNextPage" Content="Próxima →" Appearance="Secondary" Click="BtnImpressorasNextPage_Click" IsEnabled="False" Padding="12,6" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PAINEL 18: AGENDADORES & CRON JOBS (WSL / REDHAT) -->
                    <Grid x:Name="PanelCronJobs" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Agendadores &amp; Cron Jobs (Bancada STI)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Disparo sob demanda e monitoramento de todas as rotinas via PostgreSQL (compatível com Docker/WSL local e servidor RedHat remoto)." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary" Content="Histórico (Logs)" Icon="{ui:SymbolIcon Symbol=History24}" Click="BtnOpenCronLogsModal_Click" Margin="0,0,8,0" Padding="12,8" />
                                <ui:Button x:Name="BtnRefreshCron" Appearance="Primary" Content="Atualizar Status" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Click="BtnRefreshCron_Click" Padding="14,8" />
                            </WrapPanel>
                        </Grid>

                        <!-- KPIs -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Total de Rotinas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtCronKpiTotal" Text="-" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="Habilitadas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtCronKpiAtivas" Text="-" FontSize="16" FontWeight="Bold" Foreground="#34d399" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="Em Execução" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtCronKpiExec" Text="-" FontSize="16" FontWeight="Bold" Foreground="#38bdf8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Com Erro" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtCronKpiErro" Text="-" FontSize="16" FontWeight="Bold" Foreground="#f87171" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Filtros -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtCronSearch" Grid.Column="0" PlaceholderText="Buscar rotina por nome, task_id, categoria ou descrição..." Height="34" Margin="0,0,10,0" KeyDown="TxtCronSearch_KeyDown" />
                                <ComboBox x:Name="CmbCronCategoria" Grid.Column="1" Width="210" Height="34" SelectionChanged="CronFilter_Changed" />
                            </Grid>
                        </Border>

                        <!-- Lista de Rotinas com Botão Individual -->
                        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ItemsCronSchedules">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <Border Background="{Binding StatusBadgeBackground}" CornerRadius="4" Padding="7,2" Margin="0,2,6,2">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeForeground}" />
                                                            </Border>
                                                            <Border Background="#1e293b" CornerRadius="4" Padding="7,2" Margin="0,2,8,2">
                                                                <TextBlock Text="{Binding Categoria}" FontSize="11" Foreground="#cbd5e1" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Descricao}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                                        <WrapPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding AgendamentoDisplay, StringFormat='⏰ {0}'}" FontSize="11.5" Foreground="#94a3b8" Margin="0,0,14,2" />
                                                            <TextBlock Text="{Binding UltimaExecucaoBr, StringFormat='🕒 Última: {0}'}" FontSize="11.5" Foreground="#94a3b8" Margin="0,0,14,2" />
                                                            <TextBlock Text="{Binding TaskId, StringFormat='🆔 {0}'}" FontSize="11.5" Foreground="#64748b" Margin="0,0,0,2" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding UltimoLogDisplay, StringFormat='📝 {0}'}" FontSize="11.5" Foreground="#cbd5e1" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <ui:Button Appearance="Primary" Content="Executar Agora" Icon="{ui:SymbolIcon Symbol=Play24}" Tag="{Binding}" Click="BtnRunCronTask_Click" IsEnabled="{Binding CanTrigger}" Padding="12,7" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                                                        <CheckBox Content="Habilitada no Cron" IsChecked="{Binding Ativo, Mode=OneWay}" Tag="{Binding}" Click="BtnToggleCronActive_Click" HorizontalAlignment="Center" FontSize="11.5" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- PAINEL 14: LOGS DA APLICAÇÃO -->
                    <Grid x:Name="PanelAppLogs" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Central de Logs da Aplicação" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Histórico consolidado e monitoramento em tempo real dos logs operacionais e de segurança gravados em AmbientesHub\logs\app.log." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="BadgeAppLogsCount" Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="10,5" Background="#1e293b">
                                <TextBlock x:Name="TxtAppLogsCount" Text="0 registros" FontSize="12" FontWeight="Bold" Foreground="#38bdf8" />
                            </Border>
                        </Grid>

                        <!-- Barra de Filtros e Ações Rápidas -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Nível:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,8,4" />
                                    <ComboBox x:Name="CmbAppLogLevelFilter" SelectionChanged="CmbAppLogLevelFilter_SelectionChanged" Width="155" Height="34" Margin="0,0,12,4">
                                        <ComboBoxItem Content="Todos os Níveis" IsSelected="True" />
                                        <ComboBoxItem Content="[INFO] Informações" />
                                        <ComboBoxItem Content="[WARNING] Avisos" />
                                        <ComboBoxItem Content="[DANGER] Erros" />
                                        <ComboBoxItem Content="[SUCCESS] Sucessos" />
                                    </ComboBox>

                                    <ui:TextBox x:Name="TxtAppLogSearch" PlaceholderText="Filtrar por texto nos logs..." MinWidth="220" MaxWidth="360" Height="34" Icon="{ui:SymbolIcon Symbol=Filter24}" TextChanged="TxtAppLogSearch_TextChanged" Margin="0,0,12,4" />
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnReloadAppLogs" Appearance="Primary" Content="Recarregar" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Click="BtnReloadAppLogs_Click" Margin="0,0,8,4" Padding="12,7" ToolTip="Recarrega as entradas do arquivo de log em disco" />
                                    <ui:Button x:Name="BtnClearAppLogsView" Appearance="Secondary" Content="Limpar Tela" Icon="{ui:SymbolIcon Symbol=Broom24}" Click="BtnClearAppLogsView_Click" Margin="0,0,8,4" Padding="12,7" ToolTip="Limpa apenas a visualização atual na tela" />
                                    <ui:Button x:Name="BtnOpenAppLogsFolder" Appearance="Transparent" Content="Abrir Pasta" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Click="BtnOpenAppLogsFolder_Click" Margin="0,0,0,4" Padding="10,7" ToolTip="Abre a pasta AmbientesHub\logs no Windows Explorer" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Terminal de Logs em Cores -->
                        <Border Grid.Row="2" Margin="0,15,0,0" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Console / Visualizador de Logs do Sistema (app.log)" FontSize="12" FontWeight="SemiBold" Foreground="#38bdf8" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <CheckBox x:Name="ChkAutoScrollAppLogs" Content="Rolagem Automática" IsChecked="True" FontSize="11" Foreground="#94a3b8" />
                                    </StackPanel>
                                </Grid>
                                <RichTextBox x:Name="RichAppLogs" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" FontFamily="Consolas, Cascadia Code, Courier New" VerticalScrollBarVisibility="Auto">
                                    <FlowDocument />
                                </RichTextBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PAINEL 11: OTIMIZAÇÕES DE REGISTRO (TWEAKS & ROLLBACK) -->
                    <Grid x:Name="PanelRegistryTweaks" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Otimizações do Registro do Windows (Tweaks &amp; Rollback)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Ajustes cirúrgicos no Windows Registry para redução de latência, aceleração de menus e eliminação de bloatware em background, com backup automático (.reg) e restauração segura." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="BadgeRegistryOptStatus" Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="10,5" Background="#1e293b">
                                <TextBlock x:Name="TxtRegistryOptBadge" Text="0 / 12 Otimizados" FontSize="12" FontWeight="Bold" Foreground="#38bdf8" />
                            </Border>
                        </Grid>

                        <!-- Barra de Filtros e Ações Rápidas -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <!-- Filtros: Categoria e Seleção -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Categoria:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,8,4" />
                                    <ComboBox x:Name="CmbRegistryCategoryFilter" SelectionChanged="CmbRegistryCategoryFilter_SelectionChanged" Width="195" Height="34" Margin="0,0,12,4">
                                        <ComboBoxItem Content="Todas as Categorias" IsSelected="True" />
                                        <ComboBoxItem Content="Responsividade &amp; UI" />
                                        <ComboBoxItem Content="Inicialização &amp; Encerramento" />
                                        <ComboBoxItem Content="Sistema &amp; Background" />
                                        <ComboBoxItem Content="Rede &amp; Multimídia" />
                                    </ComboBox>

                                    <ui:Button x:Name="BtnSelectAllRegistryTweaks" Appearance="Secondary" Content="Marcar Todos" Click="BtnSelectAllRegistryTweaks_Click" Margin="0,0,6,4" Padding="10,6" />
                                    <ui:Button x:Name="BtnDeselectAllRegistryTweaks" Appearance="Transparent" Content="Desmarcar" Click="BtnDeselectAllRegistryTweaks_Click" Margin="0,0,0,4" Padding="10,6" />
                                </WrapPanel>

                                <!-- Ações Principais -->
                                <WrapPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnScanRegistryTweaks" Appearance="Secondary" Content="Escanear Registro" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Click="BtnScanRegistryTweaks_Click" Margin="0,0,8,4" Padding="12,7" ToolTip="Verifica o estado atual das chaves no registro do Windows" />
                                    <ui:Button x:Name="BtnApplySelectedRegistryTweaks" Appearance="Primary" Content="Aplicar Selecionados" Icon="{ui:SymbolIcon Symbol=Checkmark24}" Click="BtnApplySelectedRegistryTweaks_Click" Margin="0,0,8,4" Padding="12,7" ToolTip="Gera backup automático e aplica as otimizações marcadas" />
                                    <ui:Button x:Name="BtnRollbackSelectedRegistryTweaks" Appearance="Danger" Content="Restaurar / Rollback" Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" Click="BtnRollbackSelectedRegistryTweaks_Click" Margin="0,0,8,4" Padding="12,7" ToolTip="Restaura os valores anteriores ou padrão das chaves selecionadas" />
                                    <ui:Button x:Name="BtnOpenRegistryBackupFolder" Appearance="Transparent" Content="Backups (.reg)" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Click="BtnOpenRegistryBackupFolder_Click" Margin="0,0,0,4" Padding="10,7" ToolTip="Abre a pasta de backups de registro C:\AmbientesVirtuais\Backups" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Lista de Tweaks (ScrollViewer + ItemsControl estilizado) -->
                        <Border Grid.Row="2" Margin="0,12,0,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LstRegistryTweaks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Checkbox de Seleção -->
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                                    <!-- Detalhes do Tweak -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <WrapPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Emoji}" FontSize="15" Margin="0,2,6,2" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,2,10,2" TextWrapping="Wrap" />

                                                            <!-- Badge de Categoria -->
                                                            <Border Background="#1e293b" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#94a3b8" />
                                                            </Border>

                                                            <!-- Badge de Privilégio (HKCU vs HKLM) -->
                                                            <Border CornerRadius="4" Padding="6,2" Margin="0,2,6,2" Background="{Binding PrivilegeBadgeBackground}">
                                                                <TextBlock Text="{Binding PrivilegeTag}" FontSize="11" FontWeight="Medium" Foreground="{Binding PrivilegeBadgeForeground}" />
                                                            </Border>

                                                            <!-- Badge de Status Atual -->
                                                            <Border CornerRadius="4" Padding="8,2" Margin="0,2,0,2" Background="{Binding StatusBadgeBackground}">
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeForeground}" />
                                                            </Border>
                                                        </WrapPanel>

                                                        <!-- Descrição -->
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="21,4,0,4" TextWrapping="Wrap" />

                                                        <!-- Informações Técnicas da Chave -->
                                                        <WrapPanel Orientation="Horizontal" Margin="21,0,0,0">
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,14,1">
                                                                <TextBlock Text="Chave: " FontSize="11" FontWeight="SemiBold" Foreground="#64748b" />
                                                                <TextBlock Text="{Binding FullRegistryPath}" FontSize="11" FontFamily="Consolas" Foreground="#94a3b8" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,14,1">
                                                                <TextBlock Text="Atual: " FontSize="11" FontWeight="SemiBold" Foreground="#64748b" />
                                                                <TextBlock Text="{Binding CurrentValueDisplay}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="#f8fafc" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,14,1">
                                                                <TextBlock Text="Recomendado: " FontSize="11" FontWeight="SemiBold" Foreground="#64748b" />
                                                                <TextBlock Text="{Binding RecommendedValueDisplay}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="#38bdf8" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                                <TextBlock Text="Padrão: " FontSize="11" FontWeight="SemiBold" Foreground="#64748b" />
                                                                <TextBlock Text="{Binding DefaultValueDisplay}" FontSize="11" FontFamily="Consolas" Foreground="#94a3b8" />
                                                            </StackPanel>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <!-- Botões de Ação Rápida por Item -->
                                                    <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Content="Aplicar" Appearance="Primary" Padding="10,5" Margin="0,2,6,2" Tag="{Binding}" Click="BtnApplySingleTweak_Click" ToolTip="Aplica este tweak individualmente" />
                                                        <ui:Button Content="Restaurar" Appearance="Secondary" Padding="10,5" Margin="0,2,0,2" Tag="{Binding}" Click="BtnRollbackSingleTweak_Click" ToolTip="Restaura o valor original/padrão deste tweak" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Terminal de Logs de Registro -->
                        <Border Grid.Row="3" Height="130" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Console de Operações de Registro &amp; Rollback" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8" Margin="0,0,0,4" />
                                <RichTextBox x:Name="RichRegistryLogs" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="11" FontFamily="Consolas, Cascadia Code, Courier New" VerticalScrollBarVisibility="Auto">
                                    <FlowDocument />
                                </RichTextBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PAINEL 19: MAPA VISUAL DE ROTA & PING (TRACEROUTE NATIVO) -->
                    <views:NetworkPathView x:Name="PanelNetworkPath" Visibility="Collapsed" />

                    <!-- PAINEL 20: MONITOR ZABBIX (COMARCAS & SWITCHES) -->
                    <views:ZabbixMonitorView x:Name="PanelZabbixMonitor" Visibility="Collapsed" />

                    <!-- PAINEL 21: VIZINHOS DE REDE & TABELA ARP -->
                    <views:SubnetNeighborsView x:Name="PanelSubnetNeighbors" Visibility="Collapsed" />

                    <!-- PAINEL 22: SERVIDORES & ACESSO RDP (RDM LOCAL) -->
                    <views:RdpServersView x:Name="PanelRdpServers" Visibility="Collapsed" />

                    <!-- PAINEL 23: MIGRAÇÃO & PORTAS DE IMPRESSORAS NO PRINT SERVER -->
                    <views:PrinterMigrationView x:Name="PanelPrinterMigration" Visibility="Collapsed" />

                    <!-- PAINEL 24: DOCUMENTAÇÃO TÉCNICA & MANUAIS (MARKDOWN NATIVO) -->
                    <views:DocumentationView x:Name="PanelDocumentation" Visibility="Collapsed" />

                </Grid>
            </Border>
        </Grid>

        <!-- Barra de Status Rodapé -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="15,6">
            <TextBlock x:Name="TxtFooterStatus" Text="Ambientes Hub ativo e pronto." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</ui:FluentWindow>
