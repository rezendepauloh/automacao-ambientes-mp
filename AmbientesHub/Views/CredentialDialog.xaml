<ui:FluentWindow x:Class="AmbientesHub.Views.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cofre Seguro de Credenciais"
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid Margin="24,10,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título -->
        <ui:TitleBar Grid.Row="0" Title="Cofre DPAPI" Margin="-14,-5,-14,10" />

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:SymbolIcon Symbol="Key24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                <TextBlock Text="Armazenar Credencial Segura" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="A senha é protegida nativamente pelo Windows DPAPI do seu usuário atual." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Formulário -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="Nome de Usuário (Domínio ou Local):" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
            <ui:TextBox x:Name="TxtUser" PlaceholderText="Ex: mpe\usuario_admin ou usuario_admin" Margin="0,0,0,12" Height="36" />

            <TextBlock Text="Senha:" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,8" Height="36" KeyDown="TxtPassword_KeyDown" VerticalContentAlignment="Center" Padding="8,0" />
            
            <TextBlock x:Name="TxtError" Text="" FontSize="11" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Ações -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <ui:Button Appearance="Secondary" Content="Cancelar" Click="BtnCancel_Click" Margin="0,0,10,0" Padding="16,8" />
            <ui:Button x:Name="BtnSave" Appearance="Primary" Content="Salvar no Cofre" Icon="{ui:SymbolIcon Symbol=Save24}" Click="BtnSave_Click" Padding="18,8" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
