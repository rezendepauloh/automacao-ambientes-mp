<UserControl x:Class="AmbientesHub.Views.PrinterMigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Migração &amp; Portas de Impressoras (Print Server + PaperCut Port)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Automatiza a verificação de IP/Porta no Print Management, criação de porta 'PaperCut TCP/IP Port' (PAPERCUT_IP : 9100), troca de porta da fila e página de teste." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border x:Name="BadgePrinterMigStatus" Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="12,6" Background="#1e293b" BorderBrush="#334155" BorderThickness="1">
                <TextBlock x:Name="TxtPrinterMigStatus" Text="⚪ Preencha os dados da impressora" FontSize="12" FontWeight="Bold" Foreground="#94a3b8" />
            </Border>
        </Grid>

        <!-- Corpo Principal: Formulário (Esquerda) + Cronograma & Script/Console (Direita) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="435" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Coluna Esquerda: Dados da Impressora & Ações -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dados da Impressora &amp; Print Server" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Servidor de Impressão (Print Server):" FontSize="11" Foreground="#94a3b8" />
                                <ui:TextBox x:Name="TxtPrintServer" PlaceholderText="Ex: srv-print01 ou ." MinHeight="38" Padding="10,6" Margin="0,2,0,0" TextChanged="FormInput_TextChanged" />
                            </StackPanel>
                            <ui:Button x:Name="BtnOpenServerInRdpTab" Grid.Column="1" Content="🖥️ Abrir RDP" Appearance="Secondary" VerticalAlignment="Bottom" Height="38" Padding="10,6" Click="BtnOpenServerInRdpTab_Click" ToolTip="Abre a aba Servidores &amp; RDP filtrando por este servidor" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Nome do Host / Fila (Ex: PRT-0001):" FontSize="11" Foreground="#94a3b8" />
                                <ui:TextBox x:Name="TxtPrinterName" PlaceholderText="Ex: PRT-0001" MinHeight="38" Padding="10,6" Margin="0,2,0,0" TextChanged="FormInput_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MAC Address (Opcional):" FontSize="11" Foreground="#94a3b8" />
                                <ui:TextBox x:Name="TxtMacAddress" PlaceholderText="AA:BB:CC:DD:EE:FF" MinHeight="38" Padding="10,6" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="95" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Novo Endereço IPv4 da Impressora:" FontSize="11" Foreground="#94a3b8" />
                                <ui:TextBox x:Name="TxtNewIp" PlaceholderText="Ex: 10.0.0.50" MinHeight="38" Padding="10,6" Margin="0,2,0,0" TextChanged="FormInput_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Porta RAW:" FontSize="11" Foreground="#94a3b8" />
                                <ui:TextBox x:Name="TxtPortNumber" Text="9100" MinHeight="38" Padding="10,6" Margin="0,2,0,0" TextChanged="FormInput_TextChanged" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Prefixo da Porta:" FontSize="11" Foreground="#94a3b8" />
                                <ui:TextBox x:Name="TxtPortPrefix" Text="PAPERCUT_" MinHeight="38" Padding="10,6" Margin="0,2,0,0" TextChanged="FormInput_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Port Name Resultante no Servidor:" FontSize="11" Foreground="#94a3b8" />
                                <Border Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" MinHeight="38" Padding="10,6" Margin="0,2,0,0">
                                    <TextBlock x:Name="TxtPortPreview" Text="PAPERCUT_..." FontSize="12.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Setor / Localização:" FontSize="11" Foreground="#94a3b8" />
                                <ui:TextBox x:Name="TxtLocation" PlaceholderText="Ex: Licitações / Auditoria" MinHeight="38" Padding="10,6" Margin="0,2,0,0" TextChanged="FormInput_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Modelo / Driver Padrão:" FontSize="11" Foreground="#94a3b8" />
                                <ui:TextBox x:Name="TxtDriverName" Text="HP Universal Printing PCL 6" MinHeight="38" Padding="10,6" Margin="0,2,0,0" TextChanged="FormInput_TextChanged" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,2,0,10">
                            <CheckBox x:Name="ChkSendTestPage" Content="Enviar Página de Teste após validar/atualizar" IsChecked="True" Margin="0,0,0,4" Click="FormCheck_Clicked" />
                            <CheckBox x:Name="ChkOpenQueue" Content="Abrir Fila de Impressão no servidor para acompanhar" IsChecked="True" Click="FormCheck_Clicked" />
                        </StackPanel>

                        <ui:Button x:Name="BtnCheckPrinterNet" Content="🔍 1. Testar IP da Impressora na Rede (Ping + 9100)" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="10,7" Margin="0,0,0,6" Click="BtnCheckPrinterNet_Click" />
                        <WrapPanel x:Name="NetCheckChipsPanel" Orientation="Horizontal" Margin="0,0,0,8" />

                        <ui:Button x:Name="BtnCopyServerScript" Content="📋 2. Copiar Script PowerShell (Colar no Servidor RDP)" Appearance="Primary" HorizontalAlignment="Stretch" Padding="10,8" Margin="0,0,0,6" Click="BtnCopyServerScript_Click" ToolTip="Gera e copia o script completo dos passos 3 a 10 para colar no PowerShell do servidor" />

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <ui:Button x:Name="BtnDryRunRemote" Content="🔎 Simular Remoto" Appearance="Secondary" Padding="8,6" Margin="0,0,4,0" Click="BtnDryRunRemote_Click" ToolTip="Tenta consultar a impressora remotamente via WinRM sem alterar nada" />
                            <ui:Button x:Name="BtnExecuteRemote" Content="🚀 Aplicar Remoto" Appearance="Secondary" Padding="8,6" Margin="4,0,0,0" Click="BtnExecuteRemote_Click" ToolTip="Executa a atualização remotamente via WinRM (ou localmente se servidor = .)" />
                        </UniformGrid>

                        <Separator Margin="0,0,0,8" />

                        <ui:Button x:Name="BtnOpenPaperCutWeb" Content="🌐 3. Abrir PaperCut Admin (Passo 11 — Trocar IP lá)" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="10,7" Click="BtnOpenPaperCutWeb_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Coluna Direita: Cronograma Visual (Passos 1 a 11) + Script/Console -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cronograma de 5 Blocos -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Cronograma Operacional Automatizado (Passos 1 a 11)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <UniformGrid Columns="5">
                            <Border Background="#0f172a" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="PASSOS 1–2" FontSize="10" FontWeight="Bold" Foreground="#38bdf8" />
                                    <TextBlock Text="Servidor &amp; Print Mgmt" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Acesso ao servidor alvo" FontSize="10" Foreground="#94a3b8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#0f172a" BorderBrush="#10b981" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="PASSOS 3–4" FontSize="10" FontWeight="Bold" Foreground="#34d399" />
                                    <TextBlock Text="Checar Porta Atual" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Se já for PAPERCUT_IP, para e testa" FontSize="10" Foreground="#94a3b8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#0f172a" BorderBrush="#10b981" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="PASSOS 5–8" FontSize="10" FontWeight="Bold" Foreground="#34d399" />
                                    <TextBlock Text="PaperCut TCP/IP Port" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Cria PAPERCUT_IP (9100) se faltar" FontSize="10" Foreground="#94a3b8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#0f172a" BorderBrush="#10b981" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="PASSOS 9–10" FontSize="10" FontWeight="Bold" Foreground="#34d399" />
                                    <TextBlock Text="Trocar Porta &amp; Teste" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Set-Printer + Página de Teste + Fila" FontSize="10" Foreground="#94a3b8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#0f172a" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="PASSO 11 (ABERTO)" FontSize="10" FontWeight="Bold" Foreground="#fbbf24" />
                                    <TextBlock Text="PaperCut Admin" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Trocar IP no portal PaperCut" FontSize="10" Foreground="#94a3b8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Visualizador do Script PowerShell / Saída de Console -->
                <Border Grid.Row="1" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtConsoleHeader" Grid.Column="0" Text="Script PowerShell Gerado (Pronto para execução no Print Server)" FontSize="12" FontWeight="SemiBold" Foreground="#38bdf8" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Content="Atualizar Preview do Script" Appearance="Transparent" Padding="8,4" Click="BtnRefreshScriptPreview_Click" />
                        </Grid>

                        <TextBox x:Name="TxtScriptConsole"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12"
                                 Background="Transparent"
                                 Foreground="#e2e8f0"
                                 BorderThickness="0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
