<UserControl x:Class="AmbientesHub.Views.ZabbixMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Monitor de Comarcas, Prédios &amp; Switches (Zabbix)" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Visão em tempo real dos equipamentos monitorados no Zabbix, agrupados por cidade/prédio com filtro de Online e Offline." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border x:Name="BadgeZabbixStatus" Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="12,6" Background="#1e293b" BorderBrush="#334155" BorderThickness="1">
                <TextBlock x:Name="TxtZabbixStatus" Text="⚪ Aguardando consulta" FontSize="12" FontWeight="Bold" Foreground="#94a3b8" />
            </Border>
        </Grid>

        <!-- Barra de Filtros -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="175" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Pesquisar Equipamento / IP / Cidade:" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="TxtSearch" PlaceholderText="Ex: Aquidauana, SWE-, 10.12..." Height="34" TextChanged="Filter_Changed" Icon="{ui:SymbolIcon Symbol=Search24}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Cidade / Prédio (Grupo):" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbGroupFilter" Height="34" SelectionChanged="Filter_Changed" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Status:" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbStatusFilter" Height="34" SelectedIndex="0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Todos os Status" Tag="ALL" />
                        <ComboBoxItem Content="🔴 Somente Offline" Tag="OFFLINE" />
                        <ComboBoxItem Content="🟢 Somente Online" Tag="ONLINE" />
                    </ComboBox>
                </StackPanel>

                <ui:Button x:Name="BtnRefresh" Grid.Column="3" Appearance="Primary" Content="Atualizar" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Click="BtnRefresh_Click" VerticalAlignment="Bottom" Height="34" Padding="14,6" />
            </Grid>
        </Border>

        <!-- KPIs -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="TOTAL MONITORADO" FontSize="10" Foreground="#94a3b8" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtKpiTotal" Text="0" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="ONLINE" FontSize="10" Foreground="#94a3b8" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtKpiOnline" Text="0" FontSize="18" FontWeight="Bold" Foreground="#34d399" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="OFFLINE (CAÍDOS)" FontSize="10" Foreground="#94a3b8" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtKpiOffline" Text="0" FontSize="18" FontWeight="Bold" Foreground="#f87171" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="EXIBINDO AGORA" FontSize="10" Foreground="#94a3b8" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtKpiFiltered" Text="0" FontSize="18" FontWeight="Bold" Foreground="#38bdf8" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Lista de Cards -->
        <Border Grid.Row="3" Background="#0b0f19" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsHosts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0f172a" BorderBrush="{Binding BorderHex}" BorderThickness="1.2" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{Binding BadgeBgHex}" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusColorHex}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#f8fafc" TextTrimming="CharacterEllipsis" />
                                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding IpAddress}" FontSize="11.5" FontFamily="Consolas" Foreground="#94a3b8" Margin="0,0,14,0" />
                                            <TextBlock Text="{Binding GroupName, StringFormat='📍 {0}'}" FontSize="11.5" Foreground="#38bdf8" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Secondary" Content="ℹ️ Detalhes" Padding="10,6" Margin="0,0,6,0" Tag="{Binding}" Click="BtnHostDetails_Click" />
                                        <ui:Button Appearance="Secondary" Content="🌐 Traçar Rota" Padding="10,6" Tag="{Binding}" Click="BtnTraceHost_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Paginação -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtPageInfo" Grid.Column="0" Text="Página 1 de 1 (0 itens)" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="BtnPrevPage" Content="◀ Anterior" Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" Click="BtnPrevPage_Click" IsEnabled="False" />
                <ui:Button x:Name="BtnNextPage" Content="Próxima ▶" Appearance="Secondary" Padding="10,5" Click="BtnNextPage_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
